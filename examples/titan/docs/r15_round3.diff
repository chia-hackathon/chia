@@ -0,0 +1,118 @@
+// vmttl.v vd, (rs1), rs2 [, LLAMBDA] [, vm]  — Zvvmttls Transposing
+// Tile Load. Literal transcription of the SAIL semantics.
+//
+//   For each i in [vstart, VL) where the mask is enabled:
+//     VD[i] = M[rs1 + (SEW/8) * ((i % linesize) * LD + (i / linesize))]
+//   with linesize = LAMBDA * LMUL. When rs2 = 0 the leading dimension
+//   defaults to VLEN / (SEW * LAMBDA) = M_tile = elems_per_reg / LAMBDA
+//   (the natural maximum width of a B tile / height of an A or C tile),
+//   NOT to `linesize` as for the order-preserving variant.
+// require_extension(EXT_ZVVMTTLS);  // reference model does not gate on the extension
+
+// require_vector(false) verifies !vill and enforces the standard VS
+// gating. It does NOT require vstart == 0: nonzero vstart is legal for
+// tile load/store instructions per the spec (they are restartable).
+require_vector(false);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+require(sew == 8 || sew == 16 || sew == 32 || sew == 64);
+
+// LMUL must be an integer in {1, 2, 4, 8}.
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Effective lambda per SAIL decode_tile_lambda:
+//   - Instruction-immediate lambda (bits [31:29]) if nonzero.
+//   - Otherwise vtype.lambda[2:0] (must be nonzero, else illegal).
+// A nonzero instruction immediate is checked exactly for support and
+// is not WARL-clamped.
+const reg_t imm_enc = insn.v_nf() & 0x7;
+reg_t eff_lambda;
+if (imm_enc != 0) {
+  eff_lambda = vectorUnit_t::decode_lambda_field(imm_enc);
+} else {
+  eff_lambda = P.VU.ime_lambda;
+}
