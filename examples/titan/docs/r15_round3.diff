+// per SAIL. For a tile load/store: row_elems_per_reg = eff_lambda,
+// group_regs = LMUL, elems_per_reg = VLEN/SEW.
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t ls           = row_elems_per_reg * group_regs;
+  const reg_t line         = i / ls;
+  const reg_t elem_in_line = i % ls;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+const reg_t start = P.VU.vstart->read();
