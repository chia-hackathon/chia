new file mode 100644
index 0000000..8cedddd
--- /dev/null
+++ b/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala
@@ -0,0 +1,132 @@
+// Zvvm Integer Matrix Multiply-Accumulate: vmmacc.vv and vqmmacc.vv.
+//
+// Both instructions walk the same (j, i, k) sequence; each iteration
+// produces one A * B product and folds it into the running C accumulator.
+// The only per-instruction difference is the width of A and B:
+//
+//   vmmacc.vv  (W=1)  reads A, B, C all at SEW.
+//   vqmmacc.vv (W=4)  reads A, B at EEW_A = SEW/4 and C at SEW.
+//
+// The ExecuteSequencer has already selected the right widths -- rvs1_eew /
+// rvs2_eew carry EEW_A, vd_eew carries EEW_C -- so this FU never needs to
+// know W directly.  A 64-bit signed multiply is enough for either operand
+// pair: an EEW_A x EEW_A product fits in <= 2*EEW_A <= SEW <= 64 bits after
+// sign extension.
+package saturn.exu
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.rocket._
+import freechips.rocketchip.util._
+import freechips.rocketchip.tile._
+import saturn.common._
+import saturn.insns._
+
+case class MatrixMultiplyFactory() extends FunctionalUnitFactory {
+  def insns = IMEInstructions.matrixArithInsns.map(_.elementWise.iterative)
+  def generate(implicit p: Parameters) = new MatrixMultiplyPipe()(p)
+}
+
+class MatrixMultiplyPipe(implicit p: Parameters) extends IterativeFunctionalUnit()(p) {
+  io.set_vxsat := false.B
+  io.set_fflags.valid := false.B
+  io.set_fflags.bits := DontCare
+  io.scalar_write.valid := false.B
+  io.scalar_write.bits := DontCare
+  io.acc := false.B
+
+  // Per-operand element widths.  For vmmacc.vv all three are equal to SEW;
+  // for vqmmacc.vv the sequencer sets rvs1_eew = rvs2_eew = SEW/4 and leaves
+  // vd_eew at SEW.  matrix_a_pos / matrix_b_pos / matrix_c_pos are byte
+  // positions within the dLen chunk carried by rvs1_data / rvs2_data /
+  // rvd_data respectively, so dividing by the operand's element size in
+  // bytes recovers the in-chunk element index.
+  val sew_a = op.rvs1_eew
+  val sew_b = op.rvs2_eew
+  val sew_c = op.vd_eew
+
+  val a_elem_idx = op.matrix_a_pos >> sew_a
+  val b_elem_idx = op.matrix_b_pos >> sew_b
+  val c_elem_idx = op.matrix_c_pos >> sew_c
+
+  val a_raw = extractElem(op.rvs1_data, sew_a, a_elem_idx)(63, 0)
+  val b_raw = extractElem(op.rvs2_data, sew_b, b_elem_idx)(63, 0)
+  val c_raw = extractElem(op.rvd_data,  sew_c, c_elem_idx)(63, 0)
+
+  def signExtend(elem: UInt, sewSel: UInt, signed: Bool): SInt = {
+    VecInit.tabulate(4)({ eew =>
+      val w = 8 << eew
+      if (w >= 64) elem(63, 0)
+      else Cat(Fill(64 - w, signed && elem(w - 1)), elem(w - 1, 0))
+    })(sewSel).asSInt
+  }
+
+  // altfmt selects operand signedness: 0 = signed, 1 = unsigned.  A/B extend
+  // at their own EEW (which is SEW/W); C extends at SEW.  The extended
+  // 64-bit signed values then feed a plain 64-bit signed multiplier -- the
+  // low SEW bits of the product are correct regardless of whether the true
+  // product fits in 64 bits, because two SEW/W-wide inputs give at most a
+  // 2*SEW/W-bit product and 2*SEW/W <= SEW <= 64 for every legal geometry.
+  val a_ext = signExtend(a_raw, sew_a, !op.matrix_altfmt_A)
+  val b_ext = signExtend(b_raw, sew_b, !op.matrix_altfmt_B)
+  val c_ext = signExtend(c_raw, sew_c, true.B).asUInt
+
+  val product = (a_ext * b_ext).asUInt
+
+  // Explicit two-Reg design: capture c_ext at first_k, then accumulate
+  // products separately. At last_k, WRITE = c_captured + prev_product_sum +
+  // current_product. This eliminates the force_first Mux path where a Reg
+  // update race could contaminate matrix_acc with residual state from the
+  // previous cell.
+  val c_ext_captured = Reg(UInt(64.W))
+  val product_sum    = RegInit(0.U(64.W))
+  val valid_prev     = RegNext(valid, false.B)
+
+  when (valid && !valid_prev) {
+    when (op.matrix_first_k) {
+      c_ext_captured := c_ext
+      product_sum    := product(63, 0)
+    } .elsewhen (!op.matrix_last_k) {
+      // Skip accumulating at last_k. new_acc already includes current
+      // product via the direct add; updating product_sum here creates a
+      // race if write.ready is ever low at last_k (valid stays high a
+      // second cycle, and new_acc would then double-add the current
+      // product).
+      product_sum    := (product_sum +& product(63, 0))(63, 0)
+    }
+  }
+
+  // At the last_k write cycle, the current iter's product hasn't been folded
+  // into product_sum yet (Reg update happens at posedge). So compute:
+  //   result = c_captured + product_sum + product(current)
+  // For a K=1 cell (first_k == last_k), c_captured / product_sum still hold
+  // the PREVIOUS cell's values at the write moment. Handle by using c_ext /
+  // 0 in that case.
+  val use_first    = op.matrix_first_k
+  val write_c      = Mux(use_first, c_ext,   c_ext_captured)
+  val write_prev_s = Mux(use_first, 0.U(64.W), product_sum)
+  val new_acc      = (write_c +& write_prev_s +& product(63, 0))(63, 0)
+
+  // Truncate the accumulator back to SEW bits and splat -- the wmask below
+  // gates which byte lane actually lands.
+  val result_sew = VecInit.tabulate(4)({ eew =>
+    new_acc((8 << eew) - 1, 0)
+  })(sew_c)
+  val result_replicated = dLenSplat(result_sew, sew_c)
+
+  io.write.valid     := valid && op.matrix_last_k
+  io.write.bits.eg   := op.wvd_eg
+  io.write.bits.data := result_replicated
+  io.write.bits.mask := FillInterleaved(8, op.wmask)
+
+  io.hazard.valid    := valid
+  io.hazard.bits.eg  := op.wvd_eg
+  io.hazard.bits.vat := op.vat
+
+  io.tail := op.tail
+
+  last := Mux(op.matrix_last_k, io.write.fire, valid)
+
+  io.stall := valid
+}
