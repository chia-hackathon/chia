+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfwimmacc_vv.h
@@ -0,0 +1,13 @@
+// vfwimmacc.vv vd, vs1, vs2, v0.scale  — Zvvm microscaling integer-input
+// widening FP-accumulate matrix multiply-accumulate.
+//
+// This is the vm = 0 encoding on funct6 = 0x39; the vm = 1 encoding on
+// the same funct6 is vwmmacc.vv, implemented in vwmmacc_vv.h. The IME
+// reference model in this tree does not implement any of the floating-
+// point or microscaling variants (see the specs' encoding maps under
+// tbl-fp-encoding-map and tbl-intmx-encoding-map). Rather than leave
+// this encoding unhandled -- which would silently execute as the vm=1
+// integer form or drop through as an unknown-instruction -- raise an
+// illegal-instruction exception so software that requests it gets a
+// deterministic trap.
+require(false);
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vmmacc_vv.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vmmacc_vv.h
new file mode 100644
index 00000000..60582d8d
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vmmacc_vv.h
@@ -0,0 +1,206 @@
+// vmmacc.vv vd, vs1, vs2  — Zvvmm Integer Matrix Multiply-Accumulate.
+//
+// C  <-  C + A_tile * B_tile^T
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc:
+//   decode_gemm_geometry(1);
+//   check_int_encoding_legality(1, EEW_C, altfmt_A, altfmt_B);
+//   int_gemm(g, signed_A, signed_B, vs1, vs2, vd);
+//
+// The multiply-accumulate cannot be interrupted; nonzero vstart is
+// illegal. vm=1 is required; vm=0 for this funct6 is reserved and would
+// not decode as vmmacc.vv given our MATCH/MASK. Masking is not supported.
+// require_extension(EXT_ZVVMM);  // reference model does not gate on the extension
+
+// require_vector(true) verifies !vill and enforces vstart == 0 for ALU
+// ops (unless vstart_alu opt-in), and marks the VS field dirty.
+require_vector(true);
+
+// Per SAIL: "if vm == 0 then return Illegal_Instruction()".
+require(insn.v_vm() == 1);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// Non-widening integer form supports SEW in {8, 16, 32, 64}.
+require(sew == 8 || sew == 16 || sew == 32 || sew == 64);
+
+// IME requires an integer LMUL in {1, 2, 4, 8}. Fractional and reserved
+// LMUL raise illegal-instruction (SAIL decode_ime_lmul).
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Lambda must be selected (nonzero) and supported for (VLEN, SEW).
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+// Tile geometry (W = 1).
+//   K_eff  = LAMBDA * LMUL
+//   M      = VLEN / (SEW * LAMBDA)
+//   EMUL_C = M / LAMBDA = VLEN / (SEW * LAMBDA^2)
+//   N      = VL / (LAMBDA * LMUL)   (VL must be a multiple of LAMBDA*LMUL)
+//   N_max  = M      (physical row stride of C)
+const reg_t k_eff  = lambda * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
+
+const reg_t vl_div = lambda * lmul;
+const reg_t vl = P.VU.vl->read();
+require(vl % vl_div == 0);
+const reg_t n_tile = vl / vl_div;
+require(n_tile <= m_tile);
+
+// Register-group alignment, bounds, and destination/source overlap.
+const reg_t vd  = insn.rd();
+const reg_t vs1 = insn.rs1();
+const reg_t vs2 = insn.rs2();
+require(vs1 % lmul == 0 && vs1 + lmul <= (reg_t)NVPR);
+require(vs2 % lmul == 0 && vs2 + lmul <= (reg_t)NVPR);
+require(vd  % emul_c == 0 && vd + emul_c <= (reg_t)NVPR);
+auto overlap = [](reg_t a0, reg_t alen, reg_t b0, reg_t blen) {
+  return !(a0 + alen <= b0 || b0 + blen <= a0);
+};
+require(!overlap(vd, emul_c, vs1, lmul));
+require(!overlap(vd, emul_c, vs2, lmul));
+
+// Signedness of A and B is selected by altfmt_A / altfmt_B (0=signed,
+// 1=unsigned). C is always signed.
+const bool signed_A = (P.VU.ime_altfmt_A == 0);
+const bool signed_B = (P.VU.ime_altfmt_B == 0);
+
+// Elements per register at SEW.
+const reg_t epr   = vlen / sew;
+const reg_t n_max = m_tile;
+
+// Map a 2D tile element index to the flat register-group element index,
+// per SAIL tile_reg_idx(i, group_regs, row_elems_per_reg, elems_per_reg).
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// For W = 1, row_elems_per_reg for A/B is lambda * W = lambda.
+const reg_t rer_ab = lambda;
+
+// int_gemm: for each (j, i), accumulate the block dot product over
+// k = 0..K_eff-1 exactly, then modular-truncate to SEW bits when
+// writing back C. Because modular addition is associative and
+// commutative, any accumulation order is valid.
+for (reg_t j = 0; j < n_tile; ++j) {
+  for (reg_t i = 0; i < m_tile; ++i) {
+    // SAIL mat_C_idx, verbatim:
+    //   function mat_C_idx(i : int, j : int, N_max : int,
+    //                      EMUL_C : int, lambda : int, epr : int) -> int =
+    //     tile_reg_idx(i * N_max + j, EMUL_C, lambda, epr)
+    // The group multiplier is EMUL_C (from the tile geometry), not LMUL.
+    // At EMUL_C = 1 this collapses to the row-major i*N_max + j; at
+    // EMUL_C > 1 it does not, and the SAIL is normative.
+    const reg_t c_flat = tile_reg_idx(i * n_max + j, emul_c, lambda, epr);
+
+    // acc holds the running sum modulo 2^64 (sufficient for SEW <= 64
+    // because the spec reduces modulo 2^SEW and the low 64 bits of any
+    // 64-bit product are the same for signed and unsigned inputs).
+    uint64_t acc;
+    switch (sew) {
+      case 8:  acc = (uint64_t)(int64_t)(int8_t )P.VU.elt<int8_t >(vd, c_flat, false); break;
+      case 16: acc = (uint64_t)(int64_t)(int16_t)P.VU.elt<int16_t>(vd, c_flat, false); break;
+      case 32: acc = (uint64_t)(int64_t)(int32_t)P.VU.elt<int32_t>(vd, c_flat, false); break;
+      case 64: acc = (uint64_t)P.VU.elt<uint64_t>(vd, c_flat, false); break;
+      default: acc = 0; require(false); break;
+    }
+
+    for (reg_t k = 0; k < k_eff; ++k) {
+      const reg_t a_flat = tile_reg_idx(i * k_eff + k, lmul, rer_ab, epr);
+      const reg_t b_flat = tile_reg_idx(j * k_eff + k, lmul, rer_ab, epr);
+
+      uint64_t prod;
+      switch (sew) {
+        case 8: {
+          int64_t a = signed_A
+              ? (int64_t)(int8_t )P.VU.elt<int8_t >(vs1, a_flat, false)
+              : (int64_t)(uint64_t)P.VU.elt<uint8_t>(vs1, a_flat, false);
+          int64_t b = signed_B
+              ? (int64_t)(int8_t )P.VU.elt<int8_t >(vs2, b_flat, false)
+              : (int64_t)(uint64_t)P.VU.elt<uint8_t>(vs2, b_flat, false);
+          // Compute in uint64_t to sidestep signed-overflow UB.
+          // Sign-extended operands cast to uint64_t retain their two's-complement
+          // bit pattern; the low 64 bits of the product are the same as the low
+          // 64 bits of the full signed-signed / signed-unsigned / unsigned-unsigned
+          // product, which is exactly what accumulation modulo 2^SEW requires.
+          prod = (uint64_t)a * (uint64_t)b;
+          break;
+        }
+        case 16: {
+          int64_t a = signed_A
+              ? (int64_t)(int16_t )P.VU.elt<int16_t >(vs1, a_flat, false)
+              : (int64_t)(uint64_t)P.VU.elt<uint16_t>(vs1, a_flat, false);
+          int64_t b = signed_B
+              ? (int64_t)(int16_t )P.VU.elt<int16_t >(vs2, b_flat, false)
+              : (int64_t)(uint64_t)P.VU.elt<uint16_t>(vs2, b_flat, false);
+          // Compute in uint64_t to sidestep signed-overflow UB.
+          // Sign-extended operands cast to uint64_t retain their two's-complement
+          // bit pattern; the low 64 bits of the product are the same as the low
+          // 64 bits of the full signed-signed / signed-unsigned / unsigned-unsigned
+          // product, which is exactly what accumulation modulo 2^SEW requires.
+          prod = (uint64_t)a * (uint64_t)b;
+          break;
+        }
+        case 32: {
+          int64_t a = signed_A
+              ? (int64_t)(int32_t )P.VU.elt<int32_t >(vs1, a_flat, false)
+              : (int64_t)(uint64_t)P.VU.elt<uint32_t>(vs1, a_flat, false);
+          int64_t b = signed_B
+              ? (int64_t)(int32_t )P.VU.elt<int32_t >(vs2, b_flat, false)
+              : (int64_t)(uint64_t)P.VU.elt<uint32_t>(vs2, b_flat, false);
+          // Compute in uint64_t to sidestep signed-overflow UB.
+          // Sign-extended operands cast to uint64_t retain their two's-complement
+          // bit pattern; the low 64 bits of the product are the same as the low
+          // 64 bits of the full signed-signed / signed-unsigned / unsigned-unsigned
+          // product, which is exactly what accumulation modulo 2^SEW requires.
+          prod = (uint64_t)a * (uint64_t)b;
+          break;
+        }
+        case 64: {
+          // Modulo 2^64, the low 64 bits of a signed×signed,
+          // signed×unsigned, unsigned×signed, and unsigned×unsigned
+          // product are identical. Ignore signedness at SEW=64.
+          uint64_t a = (uint64_t)P.VU.elt<uint64_t>(vs1, a_flat, false);
+          uint64_t b = (uint64_t)P.VU.elt<uint64_t>(vs2, b_flat, false);
+          prod = a * b;
+          break;
+        }
+        default: prod = 0; require(false); break;
+      }
+      acc += prod;
+    }
+
+    // Truncate to SEW bits (modular wrap) when writing back C.
+    switch (sew) {
+      case 8:  P.VU.elt<int8_t >(vd, c_flat, true) = (int8_t )(uint8_t )acc; break;
+      case 16: P.VU.elt<int16_t>(vd, c_flat, true) = (int16_t)(uint16_t)acc; break;
+      case 32: P.VU.elt<int32_t>(vd, c_flat, true) = (int32_t)(uint32_t)acc; break;
+      case 64: P.VU.elt<int64_t>(vd, c_flat, true) = (int64_t)acc; break;
+      default: require(false); break;
+    }
+  }
+}
+
+// C tile tail policy: for j in [N, N_max) with 0 <= i < M, the C
+// elements are C-tile tail elements. The SAIL int_gemm never writes
+// them; leaving them undisturbed satisfies vta=0 (undisturbed) and is
+// also permitted under vta=1 (agnostic, may retain OR overwrite with
+// all-ones — either is legal, and undisturbed is the conservative
+// choice that does not mask hardware bugs with our agnostic-fill choice).
+
+P.VU.vstart->write(0);
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vmtl_v.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vmtl_v.h
new file mode 100644
index 00000000..ce274e5b
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vmtl_v.h
@@ -0,0 +1,110 @@
+// vmtl.v vd, (rs1), rs2 [, LLAMBDA] [, vm]  — Zvvmtls Order-Preserving
+// Tile Load. Literal transcription of the SAIL semantics.
+//
+//   For each i in [vstart, VL) where the mask is enabled:
+//     VD[i] = M[rs1 + (SEW/8) * ((i / linesize) * LD + (i % linesize))]
+//   with linesize = LAMBDA * LMUL, LD defaulting to linesize when rs2 = 0.
+// require_extension(EXT_ZVVMTLS);  // reference model does not gate on the extension
+
+// require_vector(false) verifies !vill and enforces the standard VS
+// gating. It does NOT require vstart == 0: nonzero vstart is legal for
+// tile load/store instructions per the spec (they are restartable).
+require_vector(false);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+require(sew == 8 || sew == 16 || sew == 32 || sew == 64);
+
+// LMUL must be an integer in {1, 2, 4, 8}.
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Effective lambda per SAIL decode_tile_lambda:
+//   - Instruction-immediate lambda (bits [31:29]) if nonzero.
+//   - Otherwise vtype.lambda[2:0] (must be nonzero, else illegal).
+// A nonzero instruction immediate is checked exactly for support and
+// is not WARL-clamped.
+const reg_t imm_enc = insn.v_nf() & 0x7;
+reg_t eff_lambda;
+if (imm_enc != 0) {
+  eff_lambda = vectorUnit_t::decode_lambda_field(imm_enc);
+} else {
+  eff_lambda = P.VU.ime_lambda;
+}
+require(eff_lambda != 0);
+require(P.VU.ime_lambda_supported(sew, eff_lambda));
+
+const reg_t linesize      = eff_lambda * lmul;
+const reg_t elems_per_reg = vlen / sew;
+const reg_t vl            = P.VU.vl->read();
+require(vl % linesize == 0);
+
+const reg_t vd = insn.rd();
+require(vd % lmul == 0 && vd + lmul <= (reg_t)NVPR);
+
+const bool masked = (insn.v_vm() == 0);
+if (masked) {
+  // A masked tile load's destination must not overlap v0. Since vd is
+  // LMUL-aligned, that happens exactly when vd == 0.
+  require(vd != 0);
+}
+
+const reg_t base_addr = RS1;
+reg_t ld = RS2;                              // leading dimension in elements
+if (ld == 0) ld = linesize;                  // rs2 = x0 default
+
+const reg_t eew_bytes = sew / 8;
+
+// tile_reg_idx: flat register-group element index for tile element i,
+// per SAIL. For a tile load/store: row_elems_per_reg = eff_lambda,
+// group_regs = LMUL, elems_per_reg = VLEN/SEW.
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t ls           = row_elems_per_reg * group_regs;
