+const reg_t elems_per_reg = vlen / sew;
+const reg_t vl            = P.VU.vl->read();
+require(vl % linesize == 0);
+
+const reg_t vd = insn.rd();
+require(vd % lmul == 0 && vd + lmul <= (reg_t)NVPR);
