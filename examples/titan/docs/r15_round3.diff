+// v8wmmacc.vv vd, vs1, vs2  — Zvvmm Integer 8x-Widening Matrix
+// Multiply-Accumulate.
+//
+// C  <-  C + A_tile * B_tile^T
+// with widening factor W = 8 applied to the K dimension.
+// A_tile and B_tile have elements of width SEW/8; C has elements of width SEW.
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc:
+//
+//   let g : gemm_geom = decode_gemm_geometry(8);
+//   check_int_encoding_legality(8, g.EEW_C, vtype[altfmt_A], vtype[altfmt_B]);
+//   let signed_A : bool = vtype[altfmt_A] == 0b0;
+//   let signed_B : bool = vtype[altfmt_B] == 0b0;
+//   int_gemm(g, signed_A, signed_B, vs1, vs2, vd);
+//
+// The multiply-accumulate cannot be interrupted; nonzero vstart is
+// illegal. vm=1 is required; vm=0 for this funct6 is separately defined
+// as vf8wimmacc.vv and would not decode as v8wmmacc.vv given our
+// MATCH/MASK. Masking is not supported.
+// require_extension(EXT_ZVVMM);  // reference model does not gate on the extension
+
+// require_vector(true) verifies !vill and enforces vstart == 0 for ALU
+// ops (unless vstart_alu opt-in), and marks the VS field dirty.
+require_vector(true);
+
+// Per SAIL: vm=1 is the v8wmmacc form. Our MATCH/MASK already gates on
+// bit 25 = 1, so this is defensive.
+require(insn.v_vm() == 1);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// 8x-widening: per tbl-int-encoding-map, SEW in {8, 16} is _reserved_
+// (EEW = 1 or 2 is not a defined input element width for integer GEMM).
+// Only SEW in {32, 64} is legal, giving EEW = SEW/8 in {4, 8}.
+require(sew == 32 || sew == 64);
+
+// IME requires an integer LMUL in {1, 2, 4, 8}. Fractional and reserved
+// LMUL raise illegal-instruction (SAIL decode_ime_lmul).
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Lambda must be selected (nonzero) and supported for (VLEN, SEW).
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+// Tile geometry (W = 8).  decode_gemm_geometry with W = 8:
+//   EEW_C  = SEW
+//   EEW_A  = SEW / W = SEW / 8          (in bits)
+//   K_eff  = LAMBDA * W * LMUL          = LAMBDA * 8 * LMUL
+//   M      = LMUL * VLEN / (EEW_A * K_eff)
+//          = LMUL * VLEN / ((SEW/8) * LAMBDA * 8 * LMUL)
+//          = VLEN / (SEW * LAMBDA)
+//   EMUL_C = M / LAMBDA = VLEN / (SEW * LAMBDA^2)
+//   N      = VL / (LAMBDA * LMUL)       (VL must be a multiple of LAMBDA*LMUL)
+//   N_max  = M                          (physical row stride of C)
+const reg_t W      = 8;
+const reg_t eew_a  = sew / W;                     // in bits (4 or 8)
+const reg_t k_eff  = lambda * W * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
