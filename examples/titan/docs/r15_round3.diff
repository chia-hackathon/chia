+  //     let flat_idx : int =
+  //       tile_reg_idx(i, LMUL, eff_lambda, elems_per_reg);
+  //     let mem_off : int =
+  //       (i % linesize) * LD + (i / linesize);
+  // vs. the order-preserving vmtl.v, only the memory offset formula
+  // changes: div and mod are swapped. The register side (flat_idx) is
+  // the same, so the two-dimensional register-file layout is identical
+  // to vmtl.v; the difference is entirely in which memory element
+  // supplies each tile position.
+  const reg_t flat_idx = tile_reg_idx(i, lmul, eff_lambda, elems_per_reg);
+  const reg_t mem_off  = (i % linesize) * ld + (i / linesize);
+  const reg_t addr     = base_addr + mem_off * eew_bytes;
+
+  switch (sew) {
+    case 8:  P.VU.elt<uint8_t >(vd, flat_idx, true) = MMU.load<uint8_t >(addr); break;
+    case 16: P.VU.elt<uint16_t>(vd, flat_idx, true) = MMU.load<uint16_t>(addr); break;
+    case 32: P.VU.elt<uint32_t>(vd, flat_idx, true) = MMU.load<uint32_t>(addr); break;
+    case 64: P.VU.elt<uint64_t>(vd, flat_idx, true) = MMU.load<uint64_t>(addr); break;
+    default: require(false); break;
+  }
+}
+
+// Tail elements (index >= VL) are excluded by the loop bound and are
+// left undisturbed. On successful completion, vstart is cleared.
+P.VU.vstart->write(0);
