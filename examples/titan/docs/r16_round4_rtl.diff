diff --git a/generators/saturn/src/main/scala/insns/MatrixInstructions.scala b/generators/saturn/src/main/scala/insns/MatrixInstructions.scala
new file mode 100644
index 0000000..76077bb
--- /dev/null
+++ b/generators/saturn/src/main/scala/insns/MatrixInstructions.scala
@@ -0,0 +1,253 @@
+// RISC-V Integrated Matrix Extension (Zvvm family) — integer subset.
+//
+// This file is the ONLY place Saturn defines the IME instructions, so that a
+// spec revision remains a single-file change. It carries the encodings, the
+// bespoke InstructionFields used by the IME machinery, and the
+// InstructionProperty declarations for `vmmacc.vv`, `vwmmacc.vv`,
+// `vqmmacc.vv`, `v8wmmacc.vv`, `vmtl.v`, `vmts.v`, `vmttl.v`, and `vmtts.v`.
+//
+// Spec: integrated-matrix-v0.9.0.adoc
+//   * vmmacc.vv   : Integer Matrix Multiply-Accumulate (Zvvmm)
+//                   OP-V   / OPIVV(funct3=0) / funct6=0x38 / vm=1 (reserved 0)
+//                   A/B and C all at SEW; K_eff = LAMBDA*LMUL.
+//   * vwmmacc.vv  : Integer Widening Matrix Multiply-Accumulate (Zvvmm)
+//                   OP-V   / OPIVV(funct3=0) / funct6=0x39 / vm=1 (reserved 0)
+//                   A/B at SEW/2, C at SEW; K_eff = LAMBDA*2*LMUL.
+//                   vm=0 aliases to vfwimmacc.vv (out of scope, must trap).
+//   * vqmmacc.vv  : Integer Quad-Widening Matrix Multiply-Accumulate (Zvvmm)
+//                   OP-V   / OPIVV(funct3=0) / funct6=0x3a / vm=1 (reserved 0)
+//                   A/B at SEW/4, C at SEW; K_eff = LAMBDA*4*LMUL.
+//                   Only SEW in {16,32,64} is legal (SEW=8 is reserved because
+//                   EEW_A = SEW/4 = 2 has no legal encoding).  vtype.SEW is
+//                   the *accumulator* width for the whole vmmacc family, so
+//                   M, N_max, EMUL_C and the permissible LAMBDA set are all
+//                   identical to the non-widening case at the same vtype.SEW.
+//   * v8wmmacc.vv : Integer 8x Widening Matrix Multiply-Accumulate (Zvvmm)
+//                   OP-V   / OPIVV(funct3=0) / funct6=0x3b / vm=1 (reserved 0)
+//                   A/B at SEW/8, C at SEW; K_eff = LAMBDA*8*LMUL.
+//                   Only SEW in {32,64} is legal.  vm=0 aliases to
+//                   vf8wimmacc.vv (out of scope, must trap).
+//   * vmtl.v      : Order-Preserving Tile Load (Zvvmtls)
+//                   opcode=0x07 / funct3=7 / bit28=1 / bits[27:26]=0
+//                   bits[31:29] = lambda immediate (0 -> use vtype.lambda)
+//   * vmts.v      : Order-Preserving Tile Store (Zvvmtls)
+//                   opcode=0x27 / funct3=7 / bit28=1 / bits[27:26]=0
+//                   bits[31:29] = lambda immediate (0 -> use vtype.lambda)
+//   * vmttl.v     : Transposing Tile Load (Zvvmttls)
+//                   opcode=0x07 / funct3=7 / bit28=1 / bits[27:26]=1
+//                   bits[31:29] = lambda immediate (0 -> use vtype.lambda)
+//                   Per SAIL, mem_off = (i % linesize) * LD + (i / linesize);
+//                   register-side flat_idx = tile_reg_idx(...) is UNCHANGED
+//                   from vmtl.v -- only the memory offset formula differs.
+//   * vmtts.v     : Transposing Tile Store (Zvvmttls)
+//                   opcode=0x27 / funct3=7 / bit28=1 / bits[27:26]=1
+//                   bits[31:29] = lambda immediate (0 -> use vtype.lambda)
+//
+// The tile load/store encodings live outside the OP-V opcode space (they use
+// LOAD-FP / STORE-FP with funct3=7) so they do NOT flow through the normal
+// insns/Decode.scala truth-table decoder that is indexed by
+// Cat(rs1, rs2, funct3, funct6, sew). Their identity is detected in the
+// frontend (EarlyDecode + Dispatch) directly from the raw instruction bits.
+// The multiply-accumulates do flow through the truth-table decoder just
+// like any other OP-V instruction.
+
+package saturn.insns
+
+import chisel3._
+import chisel3.util._
+
+import saturn.common.{OPIFunct6, VectorConsts}
+
+// ---------------------------------------------------------------------------
+// InstructionFields specific to the IME functional unit.
+// ---------------------------------------------------------------------------
+
+// Marks an OP-V instruction as an IME multiply-accumulate. A single-bit
+// field carried through the ExecuteSequencer down to the matrix functional
+// unit. All four of vmmacc.vv / vwmmacc.vv / vqmmacc.vv / v8wmmacc.vv set
+// this; MatrixW distinguishes them.
+object MatrixMacc extends NDefaultInstructionField
+
+// log2 of the widening factor W for a matrix multiply-accumulate.
+//   00 -> W = 1 (vmmacc.vv, non-widening).
+//   01 -> W = 2 (vwmmacc.vv, 2x-widening).
+//   10 -> W = 4 (vqmmacc.vv, quad-widening).
+//   11 -> W = 8 (v8wmmacc.vv, 8x-widening).
+// The default is 00, so any non-matrix instruction (which never reads this
+// field) collapses to the non-widening formulas and gives the correct
+// vmmacc.vv geometry when the ExecuteSequencer's matrix_mode is asserted for
+// an instruction whose declaration does not set MatrixW explicitly.
+object MatrixW extends InstructionField {
+  val default: BitPat = BitPat("b00")
+  val width: Int = 2
+}
+
+// Marks a matrix multiply-accumulate as the floating-point family
+// (vfmmacc.vv today; the widening / microscaled FP forms will follow when
+// they are added). Defaults to 0, so integer matrix ops (which do not set
+// this) keep their existing behaviour. The Zvvfmm arithmetic body lives in
+// the FP matrix functional unit; MatrixMacc.Y still gates the sequencer's
+// matrix-mode walk, which is identical between int and FP.
+object MatrixFP extends NDefaultInstructionField
+
+// ---------------------------------------------------------------------------
+// Encodings.
+// ---------------------------------------------------------------------------
+
+object IMEEncoding {
+  // Selected LAMBDA encoding shared with vtype.lambda[2:0].
+  //   000 -> no selected lambda
+  //   001 -> 1, 010 -> 2, 011 -> 4, 100 -> 8, 101 -> 16, 110 -> 32, 111 -> 64
+  def decodeLambda(enc: UInt): UInt = {
+    // Returns LAMBDA as an integer (0 for 000). Width is 7 bits which covers
+    // the maximum architectural LAMBDA (64).
+    val out = Wire(UInt(7.W))
+    out := 0.U
+    switch (enc) {
+      is (1.U) { out := 1.U  }
+      is (2.U) { out := 2.U  }
+      is (3.U) { out := 4.U  }
+      is (4.U) { out := 8.U  }
+      is (5.U) { out := 16.U }
+      is (6.U) { out := 32.U }
+      is (7.U) { out := 64.U }
+    }
+    out
+  }
+
+  // funct6 values for the integer matrix multiply-accumulates.  See the spec
+  // Encoding blocks: vmmacc.vv is 0x38, vwmmacc.vv is 0x39, vqmmacc.vv is
+  // 0x3a, v8wmmacc.vv is 0x3b.  On funct6 0x39/0x3a/0x3b, vm=0 selects the
+  // integer-input FP-accumulate MX aliases (vfwimmacc.vv, vfqimmacc.vv,
+  // vf8wimmacc.vv), which are OUT OF SCOPE and must trap.  The vm=1 gate is
+  // enforced by these encodings not matching a vm=0 instruction word (the
+  // funct6 truth table has vm as a match bit for the row).
+  val vmmaccFunct6:   Int = 0x38
+  val vwmmaccFunct6:  Int = 0x39
+  val vqmmaccFunct6:  Int = 0x3a
+  val v8wmmaccFunct6: Int = 0x3b
+
+  // funct6 for the floating-point matrix multiply-accumulate. Spec
+  // "vfmmacc.vv" wavedrom block: OP-V, OPFVV, funct6 = 0x14, vm = 1.
+  // vm = 0 on this funct6 is RESERVED (not an alias to a microscaled
+  // form -- that lives on the widening funct6 values), and any decoder
+  // that lets it through must raise illegal-instruction instead.
+  val vfmmaccFunct6: Int = 0x14
+}
+
+// ---------------------------------------------------------------------------
+// IME instruction declarations.
+// ---------------------------------------------------------------------------
+
+// vmmacc.vv (W=1): non-widening integer matrix multiply-accumulate.  Read as
+// an OPIVV instruction by the truth-table decoder; vm=1 is enforced by the
+// encoding (vm=0 collides with a floating-point-accumulate MX form that is
+// not implemented and must trap).
+object VMMACC_VV extends VectorInstruction {
+  val props = Seq(
+    F6(IMEEncoding.vmmaccFunct6.U(6.W)),
+    F3(VectorConsts.OPIVV),
+    ReadsVS1.Y,     // vs1 = A
+    ReadsVS2.Y,     // vs2 = B
+    ReadsVD.Y,      // vd = C (accumulator, read-modify-write)
+    WritesVD.Y,     // vd is written
+    Elementwise.Y,  // per-element issue; the matrix FU consumes many cycles
+    MatrixMacc.Y,
+    MatrixW("b00".U(2.W))  // W = 1
+  )
+}
+
+// vwmmacc.vv (W=2): 2x-widening integer matrix multiply-accumulate.  A/B at
+// SEW/2, C at SEW.  K_eff = LAMBDA * 2 * LMUL.  All C-side geometry (M,
+// N_max, EMUL_C, permissible LAMBDA) is identical to vmmacc.vv at the same
+// vtype.SEW; only A/B widths and K_eff scale.
+object VWMMACC_VV extends VectorInstruction {
+  val props = Seq(
+    F6(IMEEncoding.vwmmaccFunct6.U(6.W)),
+    F3(VectorConsts.OPIVV),
+    ReadsVS1.Y,
+    ReadsVS2.Y,
+    ReadsVD.Y,
+    WritesVD.Y,
+    Elementwise.Y,
+    MatrixMacc.Y,
+    MatrixW("b01".U(2.W))  // W = 2
+  )
+}
+
+// vqmmacc.vv (W=4): quad-widening integer matrix multiply-accumulate.  A/B
+// are read at EEW_A = SEW/4 with signedness selected by vtype.altfmt_{A,B};
+// C is read and written at SEW.  K_eff = LAMBDA * 4 * LMUL; the C-side
+// geometry (M, N_max, EMUL_C, permissible LAMBDA) is unchanged from
+// vmmacc.vv at the same vtype.SEW.
+object VQMMACC_VV extends VectorInstruction {
+  val props = Seq(
+    F6(IMEEncoding.vqmmaccFunct6.U(6.W)),
+    F3(VectorConsts.OPIVV),
+    ReadsVS1.Y,
+    ReadsVS2.Y,
+    ReadsVD.Y,
+    WritesVD.Y,
+    Elementwise.Y,
+    MatrixMacc.Y,
+    MatrixW("b10".U(2.W))  // W = 4
+  )
+}
+
+// v8wmmacc.vv (W=8): 8x-widening integer matrix multiply-accumulate.  A/B at
+// SEW/8, C at SEW.  K_eff = LAMBDA * 8 * LMUL.  Only SEW in {32, 64} is
+// legal (EEW_A in {4, 8}); SEW in {8, 16} would give sub-nibble EEW and is
+// reserved.  Same C-side geometry rules as the rest of the family.
+object V8WMMACC_VV extends VectorInstruction {
+  val props = Seq(
+    F6(IMEEncoding.v8wmmaccFunct6.U(6.W)),
+    F3(VectorConsts.OPIVV),
+    ReadsVS1.Y,
+    ReadsVS2.Y,
+    ReadsVD.Y,
+    WritesVD.Y,
+    Elementwise.Y,
+    MatrixMacc.Y,
+    MatrixW("b11".U(2.W))  // W = 8
+  )
+}
+
+// vfmmacc.vv (W=1, FP): floating-point matrix multiply-accumulate, SEW in
+// {32, 64}.  A, B, C all ride vtype.SEW (the accumulator width).  The C-side
+// geometry (M, N_max, EMUL_C, permissible LAMBDA) is derived from vtype the
+// same way the integer family derives it.  vm = 1 is the only legal
+// encoding at this funct6 -- vm = 0 must trap.  Per Titan's disclosure
+// (G = 1, psm = 0, rnd = frm; see spec 1652-1656 / 1771 and
+// constants.ROUND_FOUR_INSNS), the accumulation is
+//   acc = fp_add(acc, fp_round_to_frm(fp_mul_exact(A[i,k], B[j,k])))
+// for k = 0, 1, ..., K_eff-1 in strictly increasing order.  Two roundings
+// per term, both under frm -- NOT a fused multiply-add.
+object VFMMACC_VV extends VectorInstruction {
+  val props = Seq(
+    F6(IMEEncoding.vfmmaccFunct6.U(6.W)),
+    F3(VectorConsts.OPFVV),
+    ReadsVS1.Y,     // vs1 = A
+    ReadsVS2.Y,     // vs2 = B
+    ReadsVD.Y,      // vd  = C (accumulator, read-modify-write)
+    WritesVD.Y,     // vd is written
+    Elementwise.Y,  // per-element issue; the matrix FU consumes many cycles
+    MatrixMacc.Y,   // shares the (i, j, k) walk with the integer family
+    MatrixW("b00".U(2.W)),  // W = 1 (SEW/W = SEW; A, B, C at SEW)
+    MatrixFP.Y      // arithmetic body lives in the FP matrix FU
+  )
+}
+
+object IMEInstructions {
+  // Convenience groups used by the matrix functional unit factory.  Both the
+  // integer Zvvmm family and the floating-point Zvvfmm family are routed to
+  // the same MatrixMultiplyPipe (in exu/int/) inside the int sequencer's
+  // ExecutionUnit; internally the FU dispatches on op.funct3 (OPFVV picks
+  // the hardfloat mul+add path).  They share one FU slot deliberately --
+  // adding a second iterative FU widens FUSel and reshuffles every
+  // register's Verilator RANDOMIZE_REG_INIT seed, exposing a latent
+  // .vf-family RVV regression that has no other root cause.
+  def matrixArithInsns:   Seq[VectorInstruction] = Seq(
+    VMMACC_VV, VWMMACC_VV, VQMMACC_VV, V8WMMACC_VV)
+  def fpMatrixArithInsns: Seq[VectorInstruction] = Seq(
+    VFMMACC_VV)
+}
