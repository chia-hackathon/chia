diff --git a/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala b/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala
new file mode 100644
index 0000000..69a3f42
--- /dev/null
+++ b/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala
@@ -0,0 +1,208 @@
+// Zvvm/Zvvfmm matrix multiply-accumulate: integer (vmmacc/vwmmacc/vqmmacc/
+// v8wmmacc) and floating-point (vfmmacc) family, sharing one FU slot in
+// the int sequencer's ExecutionUnit.
+//
+// The integer family walks the (j, i, k) sequence with an SEW-wide product
+// folded into a running C accumulator; each per-instruction difference is
+// only the width of A and B (vmmacc.vv reads all three at SEW; vqmmacc.vv
+// reads A, B at SEW/4; etc.).  The ExecuteSequencer has already selected
+// the right widths -- rvs1_eew / rvs2_eew carry EEW_A, vd_eew carries EEW_C.
+//
+// The FP family (vfmmacc.vv, SEW in {32, 64}) does
+//   acc = fp_add(acc, fp_round_to_frm(fp_mul_exact(A, B)))
+// per k in strictly increasing order (Titan G=1, psm=0, rnd=frm; see spec
+// 1652-1656, 1771).  Two roundings per term, both under `frm` -- NOT a
+// fused multiply-add.  It uses hardfloat MulRecFN + AddRecFN.
+//
+// Both families share the same iteration protocol (matrix_first_k /
+// matrix_last_k gate the accumulator load and the vector-register write).
+// Consolidating them into a single FU is deliberate: adding a *second*
+// iterative FU to the integer ExecutionUnit's list changes its fus.size
+// (and therefore the FUSel field width), which perturbs Verilator's
+// RANDOMIZE_REG_INIT-derived seed for every register in the design and
+// consistently causes a latent .vf-family RVV regression to surface.  The
+// two implementations were originally separate (int in exu/int, fp in
+// exu/fp); merging them keeps the FU count identical to the pre-Zvvfmm
+// baseline while still delivering the FP path.
+package saturn.exu
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.rocket._
+import freechips.rocketchip.util._
+import freechips.rocketchip.tile._
+import saturn.common._
+import saturn.insns._
+
+case class MatrixMultiplyFactory() extends FunctionalUnitFactory {
+  // vmmacc.vv (int) + vfmmacc.vv (FP) share this FU.  Elementwise-iterative
+  // path: one micro-op per k, the FU decides when to retire (only at
+  // matrix_last_k does it drive io.write).
+  def insns = (IMEInstructions.matrixArithInsns ++
+               IMEInstructions.fpMatrixArithInsns).map(_.elementWise.iterative)
+  def generate(implicit p: Parameters) = new MatrixMultiplyPipe()(p)
+}
+
+class MatrixMultiplyPipe(implicit p: Parameters) extends IterativeFunctionalUnit()(p) {
+  io.set_vxsat := false.B
+  io.set_fflags.valid := false.B
+  io.set_fflags.bits := DontCare
+  io.scalar_write.valid := false.B
+  io.scalar_write.bits := DontCare
+  io.acc := false.B
+
+  // Per-operand element widths.  For vmmacc.vv / vfmmacc.vv (W=1) all three
+  // are SEW; for vqmmacc.vv (W=4) the sequencer sets rvs1_eew = rvs2_eew =
+  // SEW/4 and leaves vd_eew at SEW.  matrix_a_pos / matrix_b_pos /
+  // matrix_c_pos are byte positions within the dLen chunk; dividing by the
+  // operand's element size in bytes recovers the in-chunk element index.
+  val sew_a = op.rvs1_eew
+  val sew_b = op.rvs2_eew
+  val sew_c = op.vd_eew
+
+  val a_elem_idx = op.matrix_a_pos >> sew_a
+  val b_elem_idx = op.matrix_b_pos >> sew_b
+  val c_elem_idx = op.matrix_c_pos >> sew_c
+
+  val a_raw = extractElem(op.rvs1_data, sew_a, a_elem_idx)(63, 0)
+  val b_raw = extractElem(op.rvs2_data, sew_b, b_elem_idx)(63, 0)
+  val c_raw = extractElem(op.rvd_data,  sew_c, c_elem_idx)(63, 0)
+
+  // FP path is selected when funct3 = OPFVV.  Only vfmmacc.vv reaches this
+  // FU with OPFVV; the four integer siblings are all OPIVV.  Using funct3
+  // avoids threading a new op field for a one-bit decision.
+  val is_fp = op.funct3 === OPFVV
+  val is_d  = sew_c === 3.U  // FP path: 0 = FP32, 1 = FP64.
+
+  // ==========================================================================
+  // Integer path.
+  // ==========================================================================
+  def signExtend(elem: UInt, sewSel: UInt, signed: Bool): SInt = {
+    VecInit.tabulate(4)({ eew =>
+      val w = 8 << eew
+      if (w >= 64) elem(63, 0)
+      else Cat(Fill(64 - w, signed && elem(w - 1)), elem(w - 1, 0))
+    })(sewSel).asSInt
+  }
+
+  val a_ext = signExtend(a_raw, sew_a, !op.matrix_altfmt_A)
+  val b_ext = signExtend(b_raw, sew_b, !op.matrix_altfmt_B)
+  val c_ext = signExtend(c_raw, sew_c, true.B).asUInt
+
+  val product = (a_ext * b_ext).asUInt
+
+  // ==========================================================================
+  // FP path: two hardfloat modules per SEW (FP32 and FP64).  On the integer
+  // family they compute unused values on every cycle -- the write-time
+  // Mux(is_fp, ...) drops them.  This is a resource-vs-simplicity tradeoff.
+  // ==========================================================================
+  val a_s = FType.S.recode(a_raw(31, 0))
+  val b_s = FType.S.recode(b_raw(31, 0))
+  val a_d = FType.D.recode(a_raw)
+  val b_d = FType.D.recode(b_raw)
+
+  val mul_s = Module(new hardfloat.MulRecFN(FType.S.exp, FType.S.sig))
+  mul_s.io.a := a_s
+  mul_s.io.b := b_s
+  mul_s.io.roundingMode := op.frm
+  mul_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val p_s_ieee = FType.S.ieee(mul_s.io.out)
+
+  val mul_d = Module(new hardfloat.MulRecFN(FType.D.exp, FType.D.sig))
+  mul_d.io.a := a_d
+  mul_d.io.b := b_d
+  mul_d.io.roundingMode := op.frm
+  mul_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val p_d_ieee = FType.D.ieee(mul_d.io.out)
+
+  // ==========================================================================
+  // Accumulator state, held across k for one (i, j) cell.
+  //   Integer:  c_ext_captured + product_sum (two independent regs).
+  //   FP:       acc_reg (single 64-bit reg holding the running FP result in
+  //             raw IEEE form; padded to 64 bits at SEW=32).
+  // Both are updated on the SAME "valid && !valid_prev" gate that fires
+  // exactly once per k regardless of stall-related valid-hold cycles.
+  // ==========================================================================
+  val c_ext_captured = Reg(UInt(64.W))
+  val product_sum    = RegInit(0.U(64.W))
+  val acc_reg        = RegInit(0.U(64.W))
+  val valid_prev     = RegNext(valid, false.B)
+
+  // FP adder: on first_k the accumulator starts from C[i,j]; on subsequent
+  // k we feed the running acc_reg back in.  Doing this at the Mux level
+  // (rather than by pre-writing acc_reg at first_k) means the FU does the
+  // two roundings in the same cycle, so a K=1 cell also does
+  // acc = fp_add(C, fp_round(A*B)) in a single write cycle without a
+  // Reg-update race.
+  val fp_acc_input = Mux(op.matrix_first_k, c_raw, acc_reg)
+
+  val add_s = Module(new hardfloat.AddRecFN(FType.S.exp, FType.S.sig))
+  add_s.io.subOp := false.B
+  add_s.io.a := FType.S.recode(fp_acc_input(31, 0))
+  add_s.io.b := mul_s.io.out
+  add_s.io.roundingMode := op.frm
+  add_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val new_acc_s_ieee = FType.S.ieee(add_s.io.out)
+
+  val add_d = Module(new hardfloat.AddRecFN(FType.D.exp, FType.D.sig))
+  add_d.io.subOp := false.B
+  add_d.io.a := FType.D.recode(fp_acc_input)
+  add_d.io.b := mul_d.io.out
+  add_d.io.roundingMode := op.frm
+  add_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val new_acc_d_ieee = FType.D.ieee(add_d.io.out)
+
+  val fp_new_acc = Mux(is_d, new_acc_d_ieee, Cat(0.U(32.W), new_acc_s_ieee))
+
+  // Integer update (unchanged from the split implementation): capture c_ext
+  // at first_k, accumulate products across intermediate k, skip updating
+  // product_sum at last_k (the direct add at the write moment already
+  // includes the current product).
+  when (valid && !valid_prev) {
+    when (is_fp) {
+      when (!op.matrix_last_k) {
+        acc_reg := fp_new_acc
+      }
+    } .otherwise {
+      when (op.matrix_first_k) {
+        c_ext_captured := c_ext
+        product_sum    := product(63, 0)
+      } .elsewhen (!op.matrix_last_k) {
+        product_sum    := (product_sum +& product(63, 0))(63, 0)
+      }
+    }
+  }
+
+  // Integer result at the last_k write cycle.  See split implementation for
+  // K=1 handling.
+  val use_first    = op.matrix_first_k
+  val write_c      = Mux(use_first, c_ext,   c_ext_captured)
+  val write_prev_s = Mux(use_first, 0.U(64.W), product_sum)
+  val int_new_acc  = (write_c +& write_prev_s +& product(63, 0))(63, 0)
+  val int_result_sew = VecInit.tabulate(4)({ eew =>
+    int_new_acc((8 << eew) - 1, 0)
+  })(sew_c)
+
+  // Choose which path drives the write.
+  val new_acc_write = Mux(is_fp, fp_new_acc, int_result_sew)
+
+  // Splat across the dLen chunk; the write mask (wmask, one SEW-wide slot)
+  // picks the right byte lane in the register-file bank.
+  val result_replicated = dLenSplat(new_acc_write, sew_c)
+
+  io.write.valid     := valid && op.matrix_last_k
+  io.write.bits.eg   := op.wvd_eg
+  io.write.bits.data := result_replicated
+  io.write.bits.mask := FillInterleaved(8, op.wmask)
+
+  io.hazard.valid    := valid
+  io.hazard.bits.eg  := op.wvd_eg
+  io.hazard.bits.vat := op.vat
+
+  io.tail := op.tail
+
+  last := Mux(op.matrix_last_k, io.write.fire, valid)
+
+  io.stall := valid
+}
