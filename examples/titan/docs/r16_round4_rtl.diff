@@ -39,6 +39,56 @@ class AddrGen(implicit p: Parameters) extends CoreModule()(p) with HasVectorPara
   val r_sidx = Reg(UInt(3.W))
   val r_head = RegInit(true.B)
 
+  // -------------------------------------------------------------------
+  // Zvvm IME tile load / store address generation.  Both variants:
+  //
+  //   Order-preserving (vmtl.v / vmts.v), per spec Sail:
+  //     mem_off = (i / linesize) * LD + (i % linesize)
+  //   Transposing     (vmttl.v / vmtts.v):
+  //     mem_off = (i % linesize) * LD + (i / linesize)
+  //
+  // with linesize = LAMBDA * LMUL and i the sequential tile element index.
+  // The two swap the roles of the div/mod result: the transposing variant
+  // sweeps the leading dimension LD every element within a line and moves
+  // by 1 across lines, which yields the column-major memory image of the
+  // same M x K_eff logical tile that the order-preserving load consumes
+  // row-major.  The register side (flat_idx = tile_reg_idx(...)) is
+  // identical, so the register contents after a vmttl.v equal what a
+  // vmtl.v of the transposed memory image would have produced.
+  //
+  // Each iteration emits ONE memory access of SEW/8 bytes. Slow but simple
+  // and always correct regardless of alignment. Bandwidth-optimized bursts
+  // are a later concern.
+  // -------------------------------------------------------------------
+  val is_tile = io.op.is_tile
+  val is_tile_transposing = io.op.is_tile_transposing
+  val tile_linesize_log2 = io.op.tile_linesize_log2
