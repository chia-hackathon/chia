--- a/toolchains/riscv-tools/riscv-isa-sim/Makefile.in
+++ b/toolchains/riscv-tools/riscv-isa-sim/Makefile.in
@@ -517,3 +517,16 @@ distclean :
 	rm -rf *~ \#* $(junk) $(dist_junk)
 
 .PHONY : clean distclean
+
+#-------------------------------------------------------------------------
+# Titan agent hook
+#
+# The Titan harness's SpikeBuildNode only runs `make -j libriscv.so`, so
+# the standalone spike binary is never rebuilt when the model changes.
+# This hook makes libriscv.so also rebuild spike and copy it into
+# $(prefix)/bin/spike (which is where the harness resolves `spike`).
+libriscv.so: | __titan_install_spike
+.PHONY: __titan_install_spike
+__titan_install_spike: spike
+	@echo "[titan-hook] installing $(CURDIR)/spike -> $(install_exes_dir)/spike"
+	@cp $(CURDIR)/spike $(install_exes_dir)/spike
