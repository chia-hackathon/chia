+// vwmmacc.vv vd, vs1, vs2  — Zvvmm Integer Widening Matrix
+// Multiply-Accumulate.
+//
+// C  <-  C + A_tile * B_tile^T
+// with widening factor W = 2 applied to the K dimension.
+// A_tile and B_tile have elements of width SEW/2; C has elements of width SEW.
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc:
+//
+//   if vstart != 0 then return Illegal_Instruction();
+//   let g : gemm_geom = decode_gemm_geometry(2);
+//   check_int_encoding_legality(2, g.EEW_C, vtype[altfmt_A], vtype[altfmt_B]);
+//   let signed_A : bool = vtype[altfmt_A] == 0b0;
+//   let signed_B : bool = vtype[altfmt_B] == 0b0;
