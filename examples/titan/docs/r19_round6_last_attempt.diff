+// Map a 2D tile element index to the flat register-group element index,
+// per SAIL tile_reg_idx(i, group_regs, row_elems_per_reg, elems_per_reg).
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// row_elems_per_reg for A/B is lambda * W = lambda * 2 (SAIL mat_A_idx /
+// mat_B_idx pass lambda * W to tile_reg_idx).
+const reg_t rer_ab = lambda * W;
+
+// Read a single EEW_A-wide A/B element (as a mathematical integer) from
+// vector-register-file base `base` at flat register-group element index
+// `flat`.  EEW_A in {4, 8, 16, 32}. For EEW_A = 4 (SEW = 8, Zvvi4i8mm),
+// two elements are packed per byte in little-endian order: the low
+// nibble is the even-indexed element, the high nibble the odd-indexed
+// one.
+auto read_ab = [&](reg_t base, reg_t flat, bool is_signed) -> int64_t {
+  switch (eew_a) {
+    case 4: {
+      const reg_t byte_idx = flat >> 1;
+      const uint8_t byte   = P.VU.elt<uint8_t>(base, byte_idx, false);
+      const uint8_t nib    = (flat & 1) ? (uint8_t)(byte >> 4)
+                                        : (uint8_t)(byte & 0xF);
+      if (is_signed) {
+        // Sign-extend from 4 bits: shift to top of a signed byte, then
+        // arithmetic-right-shift back down.
+        return (int64_t)((int8_t)(nib << 4) >> 4);
+      }
+      return (int64_t)(uint64_t)nib;
+    }
+    case 8:
+      if (is_signed)
+        return (int64_t)(int8_t)P.VU.elt<int8_t>(base, flat, false);
+      return (int64_t)(uint64_t)P.VU.elt<uint8_t>(base, flat, false);
+    case 16:
+      if (is_signed)
+        return (int64_t)(int16_t)P.VU.elt<int16_t>(base, flat, false);
+      return (int64_t)(uint64_t)P.VU.elt<uint16_t>(base, flat, false);
+    case 32:
+      if (is_signed)
+        return (int64_t)(int32_t)P.VU.elt<int32_t>(base, flat, false);
+      return (int64_t)(uint64_t)P.VU.elt<uint32_t>(base, flat, false);
+    default:
+      require(false);
+      return 0;
+  }
+};
+
