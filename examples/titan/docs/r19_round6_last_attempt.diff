@@ -180,3 +180,28 @@ class GENV256D128ShuttleCosimConfig extends Config(
   new shuttle.common.WithShuttleTileBeatBytes(16) ++
   new shuttle.common.WithNShuttleCores(1) ++
   new chipyard.config.AbstractConfig)
+
+
+// -----------------------------------------------------------------------------
+// Titan configs: base Shuttle + Saturn (VLEN=256, DLEN=128) used for IME
+// (Zvvm) work.  The base carries the design; the cosim overlay layers on
+// only the harness (cospike + trace IO + debug ROB).  Anything that changes
+// the design itself belongs in the shared base, not in the cosim fragment.
+// -----------------------------------------------------------------------------
+
+class TitanV256D128ShuttleConfig extends Config(
+  new saturn.shuttle.WithShuttleVectorUnit(256, 128, VectorParams.refParams) ++
+  new chipyard.config.WithSystemBusWidth(128) ++
+  new shuttle.common.WithShuttleTileBeatBytes(16) ++
+  new shuttle.common.WithNShuttleCores(1) ++
+  new chipyard.config.AbstractConfig)
+
+class TitanV256D128ShuttleCosimConfig extends Config(
+  new chipyard.harness.WithCospike ++
+  new chipyard.config.WithTraceIO ++
+  new saturn.shuttle.WithShuttleVectorUnit(256, 128, VectorParams.refParams) ++
+  new chipyard.config.WithSystemBusWidth(128) ++
+  new shuttle.common.WithShuttleDebugROB ++
+  new shuttle.common.WithShuttleTileBeatBytes(16) ++
+  new shuttle.common.WithNShuttleCores(1) ++
+  new chipyard.config.AbstractConfig)
