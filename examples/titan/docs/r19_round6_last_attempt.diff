diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/ime_mx_ext_macros.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/ime_mx_ext_macros.h
new file mode 100644
index 00000000..e62ef4c0
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/ime_mx_ext_macros.h
@@ -0,0 +1,149 @@
+// See LICENSE for license details.
+//
+// Shared macros for the Zvvm integrated-matrix microscaled
+// integer-input floating-point-accumulate instructions
+//   vfwimmacc.vv  (W = 2, funct6 = 0x39, vm = 0)
+//   vfqimmacc.vv  (W = 4, funct6 = 0x3a, vm = 0)
+//   vf8wimmacc.vv (W = 8, funct6 = 0x3b, vm = 0).
+//
+// All three dispatch to the SAIL top-level `int_scaled_gemm`
+// (integrated-matrix-v0.9.0.adoc, lines 5373-5409). This header
+// packages the shared inner-loop body as a macro so that each insn
+// shell can expand it once per accumulator format, filling in the
+// format-specific helpers as macro arguments.
+//
+// The macro is used inside a function body (per Spike's convention of
+// #including an insn .h file inside the fast-path wrapper), where C++
+// does not permit nested function or template definitions.  See
+// zvk_ext_macros.h for the same rationale.
+
+#ifndef _RISCV_IME_MX_EXT_MACROS_H
+#define _RISCV_IME_MX_EXT_MACROS_H
+
+// Default NaN bit patterns per accumulator format, matching softfloat's
+// specialize.h conventions. Restated here so the insn shells do not have
+// to depend on softfloat internals.
+#define IME_MX_DEFAULT_NAN_FP16  ((uint16_t)0x7E00)
+#define IME_MX_DEFAULT_NAN_BF16  ((uint16_t)0x7FC0)
+#define IME_MX_DEFAULT_NAN_FP32  ((uint32_t)0x7FC00000u)
+#define IME_MX_DEFAULT_NAN_FP64  ((uint64_t)0x7FF8000000000000ULL)
+
+// Run the SAIL int_scaled_gemm body for one accumulator format. The
+// macro is expanded inside the insn shell, at function scope, after all
+// geometry has been decoded and after any local helper lambdas have
+// been defined.
+//
+// FP_BITS_T
+//     Unsigned integer bit-container type for the accumulator format.
+//     Must be uint16_t (FP16 or BF16), uint32_t (FP32), or uint64_t
+//     (FP64); vectorUnit_t::elt has explicit instantiations for all
+//     three.
+//
+// DEFAULT_NAN
+//     Default NaN bit pattern in fmt_C (IME_MX_DEFAULT_NAN_*).
+//
+// DECODE_SCALE(byte)  -- uint8_t -> FP_BITS_T
+//     Decode a single E8M0 byte into fmt_C using the current softfloat
+//     rounding mode. May raise flags per the SAIL "normal FP
+//     conversion" rules. The 0xFF byte returns fmt_C's default NaN.
+//
+// IS_NAN(x)  -- FP_BITS_T -> bool
+//     True iff x is NaN in fmt_C.
+//
+// FMUL(a, b)  -- (FP_BITS_T, FP_BITS_T) -> FP_BITS_T
+//     IEEE-754 multiply in fmt_C, per softfloat_roundingMode.
+//
+// FADD(a, b)  -- (FP_BITS_T, FP_BITS_T) -> FP_BITS_T
+//     IEEE-754 add in fmt_C.
+//
+// ITOFP(x)  -- int64_t -> FP_BITS_T
+//     Integer-to-fmt_C conversion, per softfloat_roundingMode.
+//
+// The macro also references these locally-visible identifiers from the
+// insn shell, verbatim by name (Spike's insn .h idiom):
+//   vd, vs1, vs2                    -- register-file indices
+//   m_tile, n_tile, n_max           -- tile dimensions
+//   emul_c, lambda, lmul            -- register-group multipliers
+//   rer_ab, k_eff, block_size       -- per-block indexing
+//   s_blocks, R, epr_a, epr_c       -- derived counts / strides
+//   tile_reg_idx(...)               -- SAIL tile_reg_idx lambda
+//   read_signed_ab(base, flat)      -- signed EEW_A element reader
+//   P                               -- processor macro (see insn_macros.h)
+#define IME_MX_INT_SCALED_GEMM_LOOP(FP_BITS_T, DEFAULT_NAN,                    \
+                                    DECODE_SCALE, IS_NAN, FMUL, FADD, ITOFP)   \
+  do {                                                                         \
+    for (reg_t _j = 0; _j < n_tile; ++_j) {                                    \
+      for (reg_t _i = 0; _i < m_tile; ++_i) {                                  \
+        /* SAIL mat_C_idx: tile_reg_idx(i * N_max + j, EMUL_C, lambda, epr_C). \
+           The group multiplier is EMUL_C, not LMUL. */                        \
+        const reg_t _c_flat =                                                  \
+            tile_reg_idx(_i * n_max + _j, emul_c, lambda, epr_c);              \
+                                                                               \
+        /* SAIL: var acc = read_single_element(EEW_C, c_flat, vd). */          \
+        FP_BITS_T _acc = P.VU.elt<FP_BITS_T>(vd, _c_flat, false);              \
+        bool _nan_out = false;                                                 \
+                                                                               \
+        for (reg_t _s = 0; _s < s_blocks; ++_s) {                              \
+          /* SAIL read_block_scales (lines 5097-5124): read two 16-bit         \
+             paired-scale elements from v0 at (i*R + s) and (j*R + s),         \
+             take low byte of pair_A as scale_A, high byte of pair_B           \
+             as scale_B. */                                                    \
+          const uint16_t _pair_A =                                             \
+              P.VU.elt<uint16_t>(0, _i * R + _s, false);                       \
+          const uint16_t _pair_B =                                             \
+              P.VU.elt<uint16_t>(0, _j * R + _s, false);                       \
+          const uint8_t _sA_byte = (uint8_t)(_pair_A & 0xFF);                  \
+          const uint8_t _sB_byte = (uint8_t)((_pair_B >> 8) & 0xFF);           \
+                                                                               \
+          /* decode_scale each byte to fmt_C using frm (flags accrue). */      \
+          const FP_BITS_T _sA = DECODE_SCALE(_sA_byte);                        \
+          const FP_BITS_T _sB = DECODE_SCALE(_sB_byte);                        \
+          /* fp_mul(sA, sB, EEW_C, fmt_C, rm) -- combined block scale in       \
+             fmt_C using frm. Invalid-operation from 0 * inf (via range        \
+             conversion) accrues here. */                                      \
+          const FP_BITS_T _blk_scale = FMUL(_sA, _sB);                         \
+          /* is_nan on the combined scale (SAIL line 5123 / 5390-5392).        \
+             On NaN, later blocks contribute no flags (spec 1968-1972). */     \
+          if (IS_NAN(_blk_scale)) { _nan_out = true; break; }                  \
+                                                                               \
+          /* Exact signed integer inner product over this block's K range.     \
+             int_scaled_gemm passes signed_A = true, signed_B = true           \
+             literally at SAIL line 5397. */                                   \
+          const reg_t _k_lo = _s * block_size;                                 \
+          const reg_t _k_hi_excl =                                             \
+              (_k_lo + block_size < k_eff)                                     \
+                  ? (_k_lo + block_size) : k_eff;                              \
+          int64_t _dot = 0;                                                    \
+          for (reg_t _k = _k_lo; _k < _k_hi_excl; ++_k) {                      \
+            /* SAIL mat_A_idx / mat_B_idx: tile_reg_idx with LMUL as the       \
+               group multiplier and (lambda * W) as row_elems_per_reg. */     \
+            const reg_t _a_flat =                                              \
+                tile_reg_idx(_i * k_eff + _k, lmul, rer_ab, epr_a);            \
+            const reg_t _b_flat =                                              \
+                tile_reg_idx(_j * k_eff + _k, lmul, rer_ab, epr_a);            \
+            const int64_t _a = read_signed_ab(vs1, _a_flat);                   \
+            const int64_t _b = read_signed_ab(vs2, _b_flat);                   \
+            _dot += _a * _b;                                                   \
+          }                                                                    \
+                                                                               \
+          /* int_to_fp(dot, EEW_C, fmt_C, rm) then fp_add(acc, fp_mul(...)).   \
+             Softfloat's i64_to_f* rounds per softfloat_roundingMode and       \
+             raises inexact/overflow as an ordinary int->fp conversion. */    \
+          const FP_BITS_T _fp_sum = ITOFP(_dot);                               \
+          const FP_BITS_T _scaled = FMUL(_blk_scale, _fp_sum);                 \
+          _acc = FADD(_acc, _scaled);                                          \
+        }                                                                      \
+                                                                               \
+        /* On NaN early exit (SAIL lines 5403-5404), the output element is     \
+           written as fmt_C's default NaN; otherwise, the accumulated          \
+           value. */                                                           \
+        if (_nan_out) {                                                        \
+          P.VU.elt<FP_BITS_T>(vd, _c_flat, true) = (FP_BITS_T)(DEFAULT_NAN);   \
+        } else {                                                               \
+          P.VU.elt<FP_BITS_T>(vd, _c_flat, true) = _acc;                       \
+        }                                                                      \
+      }                                                                        \
+    }                                                                          \
+  } while (0)
+
+#endif  // _RISCV_IME_MX_EXT_MACROS_H
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/v8wmmacc_vv.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/v8wmmacc_vv.h
new file mode 100644
index 00000000..7a45de49
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/v8wmmacc_vv.h
@@ -0,0 +1,194 @@
+// v8wmmacc.vv vd, vs1, vs2  — Zvvmm Integer 8x-Widening Matrix
+// Multiply-Accumulate.
+//
+// C  <-  C + A_tile * B_tile^T
+// with widening factor W = 8 applied to the K dimension.
+// A_tile and B_tile have elements of width SEW/8; C has elements of width SEW.
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc:
+//
+//   let g : gemm_geom = decode_gemm_geometry(8);
+//   check_int_encoding_legality(8, g.EEW_C, vtype[altfmt_A], vtype[altfmt_B]);
+//   let signed_A : bool = vtype[altfmt_A] == 0b0;
+//   let signed_B : bool = vtype[altfmt_B] == 0b0;
+//   int_gemm(g, signed_A, signed_B, vs1, vs2, vd);
+//
+// The multiply-accumulate cannot be interrupted; nonzero vstart is
+// illegal. vm=1 is required; vm=0 for this funct6 is separately defined
+// as vf8wimmacc.vv and would not decode as v8wmmacc.vv given our
+// MATCH/MASK. Masking is not supported.
+// require_extension(EXT_ZVVMM);  // reference model does not gate on the extension
+
+// require_vector(true) verifies !vill and enforces vstart == 0 for ALU
+// ops (unless vstart_alu opt-in), and marks the VS field dirty.
+require_vector(true);
+
+// Per SAIL: vm=1 is the v8wmmacc form. Our MATCH/MASK already gates on
+// bit 25 = 1, so this is defensive.
+require(insn.v_vm() == 1);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// 8x-widening: per tbl-int-encoding-map, SEW in {8, 16} is _reserved_
+// (EEW = 1 or 2 is not a defined input element width for integer GEMM).
+// Only SEW in {32, 64} is legal, giving EEW = SEW/8 in {4, 8}.
+require(sew == 32 || sew == 64);
+
+// IME requires an integer LMUL in {1, 2, 4, 8}. Fractional and reserved
+// LMUL raise illegal-instruction (SAIL decode_ime_lmul).
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Lambda must be selected (nonzero) and supported for (VLEN, SEW).
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+// Tile geometry (W = 8).  decode_gemm_geometry with W = 8:
+//   EEW_C  = SEW
+//   EEW_A  = SEW / W = SEW / 8          (in bits)
+//   K_eff  = LAMBDA * W * LMUL          = LAMBDA * 8 * LMUL
+//   M      = LMUL * VLEN / (EEW_A * K_eff)
+//          = LMUL * VLEN / ((SEW/8) * LAMBDA * 8 * LMUL)
+//          = VLEN / (SEW * LAMBDA)
+//   EMUL_C = M / LAMBDA = VLEN / (SEW * LAMBDA^2)
+//   N      = VL / (LAMBDA * LMUL)       (VL must be a multiple of LAMBDA*LMUL)
+//   N_max  = M                          (physical row stride of C)
+const reg_t W      = 8;
+const reg_t eew_a  = sew / W;                     // in bits (4 or 8)
+const reg_t k_eff  = lambda * W * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
+
+const reg_t vl_div = lambda * lmul;
+const reg_t vl = P.VU.vl->read();
+require(vl % vl_div == 0);
+const reg_t n_tile = vl / vl_div;
+require(n_tile <= m_tile);
+
+// Register-group alignment, bounds, and destination/source overlap.
+// vs1, vs2 form LMUL-register groups; vd forms an EMUL_C-register group.
+const reg_t vd  = insn.rd();
+const reg_t vs1 = insn.rs1();
+const reg_t vs2 = insn.rs2();
+require(vs1 % lmul == 0 && vs1 + lmul <= (reg_t)NVPR);
+require(vs2 % lmul == 0 && vs2 + lmul <= (reg_t)NVPR);
+require(vd  % emul_c == 0 && vd + emul_c <= (reg_t)NVPR);
+auto overlap = [](reg_t a0, reg_t alen, reg_t b0, reg_t blen) {
+  return !(a0 + alen <= b0 || b0 + blen <= a0);
+};
+require(!overlap(vd, emul_c, vs1, lmul));
+require(!overlap(vd, emul_c, vs2, lmul));
+
+// Signedness of A and B is selected by altfmt_A / altfmt_B (0 = signed,
+// 1 = unsigned). C is always signed.
+const bool signed_A = (P.VU.ime_altfmt_A == 0);
+const bool signed_B = (P.VU.ime_altfmt_B == 0);
+
+// Elements per register at EEW_A (for A/B) and EEW_C (= SEW, for C).
+const reg_t epr_a = vlen / eew_a;
+const reg_t epr_c = vlen / sew;
+const reg_t n_max = m_tile;
+
+// Map a 2D tile element index to the flat register-group element index,
+// per SAIL tile_reg_idx(i, group_regs, row_elems_per_reg, elems_per_reg).
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// row_elems_per_reg for A/B is lambda * W = lambda * 8 (SAIL mat_A_idx /
+// mat_B_idx pass lambda * W to tile_reg_idx).
+const reg_t rer_ab = lambda * W;
+
+// Read a single EEW_A-wide A/B element (as a mathematical integer) from
+// vector-register-file base `base` at flat register-group element index
+// `flat`.  EEW_A in {4, 8}. For EEW_A = 4 (SEW = 32, Zvvi4i32mm), two
+// elements are packed per byte in little-endian order: the low nibble
+// is the even-indexed element, the high nibble the odd-indexed one.
+auto read_ab = [&](reg_t base, reg_t flat, bool is_signed) -> int64_t {
+  switch (eew_a) {
+    case 4: {
+      const reg_t byte_idx = flat >> 1;
+      const uint8_t byte   = P.VU.elt<uint8_t>(base, byte_idx, false);
+      const uint8_t nib    = (flat & 1) ? (uint8_t)(byte >> 4)
+                                        : (uint8_t)(byte & 0xF);
+      if (is_signed) {
+        // Sign-extend from 4 bits: shift to top of a signed byte, then
+        // arithmetic-right-shift back down.
+        return (int64_t)((int8_t)(nib << 4) >> 4);
+      }
+      return (int64_t)(uint64_t)nib;
+    }
+    case 8:
+      if (is_signed)
+        return (int64_t)(int8_t)P.VU.elt<int8_t>(base, flat, false);
+      return (int64_t)(uint64_t)P.VU.elt<uint8_t>(base, flat, false);
+    default:
+      require(false);
+      return 0;
+  }
+};
+
+// int_gemm: for each (j, i), accumulate the block dot product over
+// k = 0..K_eff-1 exactly, then modular-truncate to SEW bits when writing
+// back C. Because modular addition is associative and commutative, any
+// accumulation order is valid.
+for (reg_t j = 0; j < n_tile; ++j) {
+  for (reg_t i = 0; i < m_tile; ++i) {
+    // SAIL mat_C_idx, verbatim:
+    //   function mat_C_idx(i : int, j : int, N_max : int,
+    //                      EMUL_C : int, lambda : int, epr : int) -> int =
+    //     tile_reg_idx(i * N_max + j, EMUL_C, lambda, epr)
+    // The group multiplier is EMUL_C (from the tile geometry), not LMUL.
+    const reg_t c_flat = tile_reg_idx(i * n_max + j, emul_c, lambda, epr_c);
+
+    // acc holds the running sum modulo 2^64.
+    uint64_t acc;
+    switch (sew) {
+      case 32: acc = (uint64_t)(int64_t)(int32_t)P.VU.elt<int32_t>(vd, c_flat, false); break;
+      case 64: acc = (uint64_t)P.VU.elt<uint64_t>(vd, c_flat, false); break;
+      default: acc = 0; require(false); break;
+    }
+
+    for (reg_t k = 0; k < k_eff; ++k) {
+      // SAIL: a_flat = mat_A_idx(i, k, K_eff, LMUL, lambda, W, epr_A)
+      //             = tile_reg_idx(i * K_eff + k, LMUL, lambda * W, epr_A)
+      //       b_flat = mat_B_idx(k, j, K_eff, LMUL, lambda, W, epr_A)
+      //             = tile_reg_idx(j * K_eff + k, LMUL, lambda * W, epr_A)
+      const reg_t a_flat = tile_reg_idx(i * k_eff + k, lmul, rer_ab, epr_a);
+      const reg_t b_flat = tile_reg_idx(j * k_eff + k, lmul, rer_ab, epr_a);
+
+      const int64_t a = read_ab(vs1, a_flat, signed_A);
+      const int64_t b = read_ab(vs2, b_flat, signed_B);
+
+      // Compute in uint64_t to sidestep signed-overflow UB.
+      const uint64_t prod = (uint64_t)a * (uint64_t)b;
+      acc += prod;
+    }
+
+    // Truncate to SEW bits (modular wrap) when writing back C.
+    switch (sew) {
+      case 32: P.VU.elt<int32_t>(vd, c_flat, true) = (int32_t)(uint32_t)acc; break;
+      case 64: P.VU.elt<int64_t>(vd, c_flat, true) = (int64_t)acc; break;
+      default: require(false); break;
+    }
+  }
+}
+
+// C tile tail policy: same as vmmacc.vv / vqmmacc.vv -- leave inactive
+// physical C columns undisturbed. Satisfies vta=0 and is a permitted
+// choice under vta=1.
+
+P.VU.vstart->write(0);
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vf8wimmacc_vv.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vf8wimmacc_vv.h
new file mode 100644
index 00000000..8ac5e0f4
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vf8wimmacc_vv.h
@@ -0,0 +1,180 @@
+// vf8wimmacc.vv vd, vs1, vs2, v0.scale  — Zvvm Integer-Input 8x-Widening
+// Floating-Point-Accumulate Matrix Multiply-Accumulate with
+// Microscaling (widening factor W = 8).
+//
+// C_fp  <-  C_fp + scale_A x scale_B x (A_int x B_int^T)
+//
+// vs1, vs2 are LMUL-grouped A/B tiles with EEW_A = SEW/8 signed integer
+// elements (4-bit at SEW = 32, 8-bit at SEW = 64). vd is EMUL_C-grouped
+// with EEW_C = SEW FP elements. v0 supplies paired E8M0 block scales.
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc (lines 6141-6164), which dispatches to
+// int_scaled_gemm (lines 5373-5409). The shared inner loop is expanded
+// via the IME_MX_INT_SCALED_GEMM_LOOP macro (ime_mx_ext_macros.h).
+//
+// Encoding: funct6 = 0x3b, funct3 = OPIVV (0x0), vm = 0. The vm = 1
+// encoding on the same funct6 is v8wmmacc.vv (integer accumulator).
+
+#include "ime_mx_ext_macros.h"
+
+require_fp;
+require_vector(true);
+require(insn.v_vm() == 0);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// tbl-intmx-encoding-map: SEW = 8 (EEW = 1) and SEW = 16 (EEW = 2) are
+// reserved for vf8wimmacc.vv; only SEW in {32, 64} is defined.
+require(sew == 32 || sew == 64);
+// altfmt = 1 is reserved at every SEW for vf8wimmacc; only FP32 and
+// FP64 accumulators are defined.
+require(P.VU.altfmt == 0);
+
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+require(P.VU.ime_altfmt_A == 0);
+require(P.VU.ime_altfmt_B == 0);
+
+// Tile geometry (W = 8).
+//   EEW_A  = SEW / 8       (4 bits at SEW=32, 8 bits at SEW=64)
+//   K_eff  = LAMBDA * 8 * LMUL
+//   M      = VLEN / (SEW * LAMBDA)
+//   EMUL_C = VLEN / (SEW * LAMBDA^2)
+const reg_t W      = 8;
+const reg_t eew_a  = sew / W;
+const reg_t k_eff  = lambda * W * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
+
+const reg_t pw = 16;
+require(sew * lambda >= pw);
+const reg_t bs = P.VU.ime_bs;
+if (bs == 1) {
+  require(W * lmul <= sew);
+}
+
+const reg_t vl_div = lambda * lmul;
+const reg_t vl = P.VU.vl->read();
+require(vl % vl_div == 0);
+const reg_t n_tile = vl / vl_div;
+require(n_tile <= m_tile);
+
+const reg_t vd  = insn.rd();
+const reg_t vs1 = insn.rs1();
+const reg_t vs2 = insn.rs2();
+require(vs1 % lmul == 0 && vs1 + lmul <= (reg_t)NVPR);
+require(vs2 % lmul == 0 && vs2 + lmul <= (reg_t)NVPR);
+require(vd  % emul_c == 0 && vd + emul_c <= (reg_t)NVPR);
+auto overlap = [](reg_t a0, reg_t alen, reg_t b0, reg_t blen) {
+  return !(a0 + alen <= b0 || b0 + blen <= a0);
+};
+require(!overlap(vd, emul_c, vs1, lmul));
+require(!overlap(vd, emul_c, vs2, lmul));
+require(!overlap(vd,  emul_c, 0, 1));
+require(!overlap(vs1, lmul,   0, 1));
+require(!overlap(vs2, lmul,   0, 1));
+
+const reg_t rer_ab     = lambda * W;
+const reg_t epr_a      = vlen / eew_a;
+const reg_t epr_c      = vlen / sew;
+const reg_t n_max      = m_tile;
+const reg_t block_size = (bs == 1) ? 16 : 32;
+const reg_t s_blocks   = (k_eff + block_size - 1) / block_size;
+const reg_t R          = lambda * sew / pw;
+
+// SAIL tile_reg_idx.
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// Signed EEW_A element reader. EEW_A is either 4 (SEW = 32) or 8
+// (SEW = 64). For EEW_A = 4, two elements are packed per byte.
+auto read_signed_ab = [&](reg_t base, reg_t flat) -> int64_t {
+  if (eew_a == 4) {
+    const reg_t byte_idx = flat >> 1;
+    const uint8_t byte   = P.VU.elt<uint8_t>(base, byte_idx, false);
+    const uint8_t nib    = (flat & 1) ? (uint8_t)(byte >> 4)
+                                      : (uint8_t)(byte & 0xF);
+    return (int64_t)((int8_t)(nib << 4) >> 4);
+  }
+  return (int64_t)(int8_t)P.VU.elt<int8_t>(base, flat, false);
+};
+
+// Exact E8M0 -> FP32 build (see vfwimmacc_vv.h for details).
+auto decode_e8m0_to_f32 = [](uint8_t byte) -> float32_t {
+  if (byte == 0xFF) return (float32_t){ 0x7FC00000u };
+  const int e = (int)byte - 127;
+  uint32_t bits;
+  if (e == -127) {
+    bits = 0x00400000u;
+  } else {
+    bits = ((uint32_t)(e + 127)) << 23;
+  }
+  return (float32_t){ bits };
+};
+
+softfloat_roundingMode = VFP_RM;
+
+// Dispatch by C accumulator format.
+if (sew == 32) {
+  // FP32 accumulator (Zvvxi4fp32mm / Zvvxni4fp32mm).
+  auto decode_scale = [&](uint8_t b) -> uint32_t {
+    return decode_e8m0_to_f32(b).v;
+  };
+  auto is_nan = [](uint32_t x) -> bool {
+    return (x & 0x7F800000u) == 0x7F800000u
+        && (x & 0x007FFFFFu) != 0;
+  };
+  auto fmul = [](uint32_t a, uint32_t b) -> uint32_t {
+    return f32_mul(float32_t{a}, float32_t{b}).v;
+  };
+  auto fadd = [](uint32_t a, uint32_t b) -> uint32_t {
+    return f32_add(float32_t{a}, float32_t{b}).v;
+  };
+  auto itofp = [](int64_t x) -> uint32_t {
+    return i64_to_f32(x).v;
+  };
+  IME_MX_INT_SCALED_GEMM_LOOP(uint32_t, IME_MX_DEFAULT_NAN_FP32,
+                              decode_scale, is_nan, fmul, fadd, itofp);
+} else {
+  // sew == 64, FP64 accumulator (Zvvxi8fp64mm / Zvvxni8fp64mm).
+  auto decode_scale = [&](uint8_t b) -> uint64_t {
+    if (b == 0xFF) return IME_MX_DEFAULT_NAN_FP64;
+    return f32_to_f64(decode_e8m0_to_f32(b)).v;
+  };
+  auto is_nan = [](uint64_t x) -> bool {
+    return (x & 0x7FF0000000000000ULL) == 0x7FF0000000000000ULL
+        && (x & 0x000FFFFFFFFFFFFFULL) != 0;
+  };
+  auto fmul = [](uint64_t a, uint64_t b) -> uint64_t {
+    return f64_mul(float64_t{a}, float64_t{b}).v;
+  };
+  auto fadd = [](uint64_t a, uint64_t b) -> uint64_t {
+    return f64_add(float64_t{a}, float64_t{b}).v;
+  };
+  auto itofp = [](int64_t x) -> uint64_t {
+    return i64_to_f64(x).v;
+  };
+  IME_MX_INT_SCALED_GEMM_LOOP(uint64_t, IME_MX_DEFAULT_NAN_FP64,
+                              decode_scale, is_nan, fmul, fadd, itofp);
+}
+
+set_fp_exceptions;
+P.VU.vstart->write(0);
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfmmacc_vv.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfmmacc_vv.h
new file mode 100644
index 00000000..425af3f2
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfmmacc_vv.h
@@ -0,0 +1,216 @@
+// vfmmacc.vv vd, vs1, vs2  — Zvvfmm Floating-Point Matrix
+// Multiply-Accumulate (non-widening, W = 1).
+//
+// C  <-  C + A_tile * B_tile^T
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc:
+//
+//   if vstart != 0 then return Illegal_Instruction();
+//   if vm == 0 then return Illegal_Instruction();  // reserved
+//
+//   let g : gemm_geom = decode_gemm_geometry(1);
+//   check_fp_encoding_legality(1, g.EEW_C,
+//                              vtype[altfmt_A], vtype[altfmt_B], vtype[altfmt]);
+//
+//   let fmt_A : fp_fmt        = fp_format_of(g.EEW_C, vtype[altfmt_A]);
+//   let fmt_B : fp_fmt        = fp_format_of(g.EEW_C, vtype[altfmt_B]);
+//   let fmt_C : fp_fmt        = fp_format_of(g.EEW_C, vtype[altfmt]);
+//   let rm    : rounding_mode = get_fp_rounding_mode();
+//
+//   fp_gemm(g, fmt_A, fmt_B, fmt_C, rm, vs1, vs2, vd);
+//
+// This reference model supports SEW in {32, 64} for vfmmacc.vv only. At
+// those widths the input formats are IEEE binary32/binary64 respectively;
+// altfmt_A, altfmt_B, and altfmt are ignored (there is only one FP format
+// per width at SEW >= 32 -- see "32-bit and wider inputs"). SEW = 8/16
+// (BF16/FP16, sub-word) is out of scope for this round; the require()
+// below gates the SAIL semantics to widths for which this model is defined.
+//
+// Titan's disclosed mapping is (G=1, psm=0, rnd=frm). Each product is its
+// own group; psm=0 keeps a one-term group sum trivially exact (S = a * b,
+// no rounding), rnd=frm rounds that exact product to fmt_C using frm, and
+// then the final accumulate performs C = round_frm(C + S_bits).
+//
+// Softfloat's f{32,64}_mul with softfloat_roundingMode = frm produces
+// exactly the bits of fp_round_to_frm(fp_mul_exact(a, b)) at fmt_C in
+// {IEEE binary32, IEEE binary64}: it forms the exact product internally
+// and rounds it to fmt_C using the current rounding mode, raising the
+// same invalid/inexact/overflow/underflow flags as the two SAIL helpers
+// combined. f{32,64}_add then supplies the ordinary
+// fp_add(acc, S_bits, EEW_C, fmt_C, frm).
+//
+// Vector masking is not supported; vm=0 on funct6 = 0x14 is reserved,
+// and our MATCH/MASK gates on bit 25 = 1 so the vm=0 encoding does not
+// decode as vfmmacc.vv.
+
+// require_fp establishes fflags access permissions (mstatus.FS != Off).
+// require_vector(true) verifies !vill and enforces vstart == 0 for ALU
+// ops (unless vstart_alu opt-in), and marks the VS field dirty.
+require_fp;
+require_vector(true);
+
+// Per SAIL: "if vm == 0 then return Illegal_Instruction()". Our MATCH/
+// MASK already gates on bit 25 = 1, so this is defense in depth.
+require(insn.v_vm() == 1);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// vfmmacc.vv at SEW = 32 or 64: IEEE binary32 / binary64 inputs and
+// accumulator. SEW = 8 or 16 requires Zvvfp16mm / Zvvbf16mm and is not
+// implemented in this reference model.
+require(sew == 32 || sew == 64);
+
+// IME requires an integer LMUL in {1, 2, 4, 8}. Fractional and reserved
+// LMUL raise illegal-instruction (SAIL decode_ime_lmul).
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Lambda must be selected (nonzero) and supported for (VLEN, SEW).
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+// Tile geometry (W = 1). decode_gemm_geometry with W = 1:
+//   EEW_C  = SEW
+//   EEW_A  = SEW / W = SEW
+//   K_eff  = LAMBDA * W * LMUL   = LAMBDA * LMUL
+//   M      = LMUL * VLEN / (EEW_A * K_eff)
+//          = VLEN / (SEW * LAMBDA)
+//   EMUL_C = M / LAMBDA          = VLEN / (SEW * LAMBDA^2)
+//   N      = VL / (LAMBDA * LMUL)   (VL must be a multiple of LAMBDA*LMUL)
+//   N_max  = M                    (physical row stride of C)
+const reg_t k_eff  = lambda * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
+
+const reg_t vl_div = lambda * lmul;
+const reg_t vl = P.VU.vl->read();
+require(vl % vl_div == 0);
+const reg_t n_tile = vl / vl_div;
+require(n_tile <= m_tile);
+
+// Register-group alignment, bounds, and destination/source overlap.
+// vs1, vs2 form LMUL-register groups; vd forms an EMUL_C-register group.
+const reg_t vd  = insn.rd();
+const reg_t vs1 = insn.rs1();
+const reg_t vs2 = insn.rs2();
+require(vs1 % lmul == 0 && vs1 + lmul <= (reg_t)NVPR);
+require(vs2 % lmul == 0 && vs2 + lmul <= (reg_t)NVPR);
+require(vd  % emul_c == 0 && vd + emul_c <= (reg_t)NVPR);
+auto overlap = [](reg_t a0, reg_t alen, reg_t b0, reg_t blen) {
+  return !(a0 + alen <= b0 || b0 + blen <= a0);
+};
+require(!overlap(vd, emul_c, vs1, lmul));
+require(!overlap(vd, emul_c, vs2, lmul));
+
+// Elements per register at SEW (= EEW_A = EEW_C at W = 1).
+const reg_t epr   = vlen / sew;
+const reg_t n_max = m_tile;
+
+// Map a 2D tile element index to the flat register-group element index,
+// per SAIL tile_reg_idx(i, group_regs, row_elems_per_reg, elems_per_reg).
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// For W = 1, row_elems_per_reg for A/B is lambda * W = lambda.
+const reg_t rer_ab = lambda;
+
+// Set the softfloat rounding mode from frm. Both fp_round_to_frm() and
+// fp_add() take rm = get_fp_rounding_mode() = frm in the SAIL body, so
+// every softfloat operation below rounds under this single mode.
+softfloat_roundingMode = VFP_RM;
+
+// fp_gemm at Titan's disclosed mapping (G=1, psm=0, rnd=frm) reduces to:
+//   for each output element C[i,j]:
+//     acc = read C[i,j]
+//     for step in [0, LMUL):
+//       for g0 in [0, lambda):           # G = 1
+//         k = step * lambda + g0         # W = 1, so k_lo == k_hi
+//         a = A_tile[i, k]
+//         b = B_tile^T[k, j]
+//         S_bits = fp_round_to_frm(fp_mul_exact(a, b))
+//                = f{32,64}_mul(a, b)     under softfloat_roundingMode=frm
+//         acc = fp_add(acc, S_bits)
+//                = f{32,64}_add(acc, S_bits) under the same mode
+//     write C[i, j] = acc
+//
+// Columns j in [N, N_max) are C tile tail elements, left undisturbed
+// (SAIL fp_gemm never writes them; that is legal under both vta=0 and
+// vta=1 for tile tails and does not mask hardware bugs the way an
+// all-ones tail fill would).
+for (reg_t j = 0; j < n_tile; ++j) {
+  for (reg_t i = 0; i < m_tile; ++i) {
+    // SAIL mat_C_idx, verbatim:
+    //   function mat_C_idx(i, j, N_max, EMUL_C, lambda, epr) =
+    //     tile_reg_idx(i * N_max + j, EMUL_C, lambda, epr)
+    // The group multiplier is EMUL_C (from the tile geometry), not LMUL.
+    const reg_t c_flat = tile_reg_idx(i * n_max + j, emul_c, lambda, epr);
+
+    if (sew == 32) {
+      float32_t acc = P.VU.elt<float32_t>(vd, c_flat, false);
+      for (reg_t step = 0; step < lmul; ++step) {
+        for (reg_t g0 = 0; g0 < lambda; ++g0) {  // G = 1
+          // For W = 1, fp_group_sum reduces to a single k:
+          //   k_lo = step * lambda * W + g0 * W = step * lambda + g0
+          //   k_hi = k_lo + g_len * W - 1     = k_lo   (g_len = G = 1)
+          const reg_t k = step * lambda + g0;
+          // SAIL: a_flat = mat_A_idx(i, k, K_eff, LMUL, lambda, W, epr_A)
+          //             = tile_reg_idx(i * K_eff + k, LMUL, lambda * W, epr_A)
+          //       b_flat = mat_B_idx(k, j, K_eff, LMUL, lambda, W, epr_A)
+          //             = tile_reg_idx(j * K_eff + k, LMUL, lambda * W, epr_A)
+          const reg_t a_flat = tile_reg_idx(i * k_eff + k, lmul, rer_ab, epr);
+          const reg_t b_flat = tile_reg_idx(j * k_eff + k, lmul, rer_ab, epr);
+
+          float32_t a = P.VU.elt<float32_t>(vs1, a_flat, false);
+          float32_t b = P.VU.elt<float32_t>(vs2, b_flat, false);
+
+          // fp_round_to_frm(fp_mul_exact(a, b)) -- softfloat's f32_mul
+          // forms the exact product and rounds it to f32 using frm, so
+          // it materializes S_bits with the same result and flags as the
+          // two SAIL helpers composed.
+          const float32_t s_bits = f32_mul(a, b);
+
+          // fp_add(acc, S_bits, EEW_C, fmt_C, frm) -- ordinary IEEE add
+          // of two fmt_C values, rounded per frm.
+          acc = f32_add(acc, s_bits);
+        }
+      }
+      P.VU.elt<float32_t>(vd, c_flat, true) = acc;
+    } else {  // sew == 64
+      float64_t acc = P.VU.elt<float64_t>(vd, c_flat, false);
+      for (reg_t step = 0; step < lmul; ++step) {
+        for (reg_t g0 = 0; g0 < lambda; ++g0) {  // G = 1
+          const reg_t k = step * lambda + g0;
+          const reg_t a_flat = tile_reg_idx(i * k_eff + k, lmul, rer_ab, epr);
+          const reg_t b_flat = tile_reg_idx(j * k_eff + k, lmul, rer_ab, epr);
+
+          float64_t a = P.VU.elt<float64_t>(vs1, a_flat, false);
+          float64_t b = P.VU.elt<float64_t>(vs2, b_flat, false);
+
+          const float64_t s_bits = f64_mul(a, b);
+          acc = f64_add(acc, s_bits);
+        }
+      }
+      P.VU.elt<float64_t>(vd, c_flat, true) = acc;
+    }
+  }
+}
+
+// Accumulate softfloat's accrued exception flags into fflags. NaNs
+// canonicalise as materialised by softfloat's default-NaN convention.
+set_fp_exceptions;
+
+P.VU.vstart->write(0);
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfqimmacc_vv.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfqimmacc_vv.h
new file mode 100644
index 00000000..819a1797
--- /dev/null
+++ b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfqimmacc_vv.h
@@ -0,0 +1,205 @@
+// vfqimmacc.vv vd, vs1, vs2, v0.scale  — Zvvm Integer-Input
+// Quad-Widening Floating-Point-Accumulate Matrix Multiply-Accumulate
+// with Microscaling (widening factor W = 4).
+//
+// C_fp  <-  C_fp + scale_A x scale_B x (A_int x B_int^T)
+//
+// vs1, vs2 are LMUL-grouped A/B tiles with EEW_A = SEW/4 signed integer
+// elements (4-bit at SEW = 16, 8-bit at SEW = 32). vd is EMUL_C-grouped
+// with EEW_C = SEW FP elements. v0 supplies paired E8M0 block scales.
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc (lines 6259-6283), which dispatches to
+// int_scaled_gemm (lines 5373-5409). The shared inner loop is expanded
+// via the IME_MX_INT_SCALED_GEMM_LOOP macro (ime_mx_ext_macros.h).
+//
+// Encoding: funct6 = 0x3a, funct3 = OPIVV (0x0), vm = 0. The vm = 1
+// encoding on the same funct6 is vqmmacc.vv (integer accumulator).
+
+#include "ime_mx_ext_macros.h"
+
+require_fp;
+require_vector(true);
+require(insn.v_vm() == 0);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// tbl-intmx-encoding-map: SEW = 8 (EEW = 2) and SEW = 64 are reserved
+// for vfqimmacc.vv.
+require(sew == 16 || sew == 32);
+// SEW = 32 with altfmt = 1 is reserved (there is no BF32 accumulator);
+// only altfmt = 0 (FP32) is defined at SEW = 32.
+if (sew == 32) require(P.VU.altfmt == 0);
+
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+require(P.VU.ime_altfmt_A == 0);
+require(P.VU.ime_altfmt_B == 0);
+
+// Tile geometry (W = 4).
+//   EEW_A  = SEW / 4       (4 bits at SEW=16, 8 bits at SEW=32)
+//   K_eff  = LAMBDA * 4 * LMUL
+//   M      = VLEN / (SEW * LAMBDA)
+//   EMUL_C = VLEN / (SEW * LAMBDA^2)
+const reg_t W      = 4;
+const reg_t eew_a  = sew / W;
+const reg_t k_eff  = lambda * W * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
+
+const reg_t pw = 16;
+require(sew * lambda >= pw);
+const reg_t bs = P.VU.ime_bs;
+if (bs == 1) {
+  require(W * lmul <= sew);
+}
+
+const reg_t vl_div = lambda * lmul;
+const reg_t vl = P.VU.vl->read();
+require(vl % vl_div == 0);
+const reg_t n_tile = vl / vl_div;
+require(n_tile <= m_tile);
+
+const reg_t vd  = insn.rd();
+const reg_t vs1 = insn.rs1();
+const reg_t vs2 = insn.rs2();
+require(vs1 % lmul == 0 && vs1 + lmul <= (reg_t)NVPR);
+require(vs2 % lmul == 0 && vs2 + lmul <= (reg_t)NVPR);
+require(vd  % emul_c == 0 && vd + emul_c <= (reg_t)NVPR);
+auto overlap = [](reg_t a0, reg_t alen, reg_t b0, reg_t blen) {
+  return !(a0 + alen <= b0 || b0 + blen <= a0);
+};
+require(!overlap(vd, emul_c, vs1, lmul));
+require(!overlap(vd, emul_c, vs2, lmul));
+require(!overlap(vd,  emul_c, 0, 1));
+require(!overlap(vs1, lmul,   0, 1));
+require(!overlap(vs2, lmul,   0, 1));
+
+const reg_t rer_ab     = lambda * W;
+const reg_t epr_a      = vlen / eew_a;
+const reg_t epr_c      = vlen / sew;
+const reg_t n_max      = m_tile;
+const reg_t block_size = (bs == 1) ? 16 : 32;
+const reg_t s_blocks   = (k_eff + block_size - 1) / block_size;
+const reg_t R          = lambda * sew / pw;
+
+// SAIL tile_reg_idx.
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// Signed EEW_A element reader. EEW_A is either 4 (SEW = 16) or 8
+// (SEW = 32). For EEW_A = 4, two elements are packed per byte in
+// little-endian order (low nibble = even index, high nibble = odd
+// index); we sign-extend from 4 bits.
+auto read_signed_ab = [&](reg_t base, reg_t flat) -> int64_t {
+  if (eew_a == 4) {
+    const reg_t byte_idx = flat >> 1;
+    const uint8_t byte   = P.VU.elt<uint8_t>(base, byte_idx, false);
+    const uint8_t nib    = (flat & 1) ? (uint8_t)(byte >> 4)
+                                      : (uint8_t)(byte & 0xF);
+    // Sign-extend from 4 bits.
+    return (int64_t)((int8_t)(nib << 4) >> 4);
+  }
+  // eew_a == 8.
+  return (int64_t)(int8_t)P.VU.elt<int8_t>(base, flat, false);
+};
+
+// Exact E8M0 -> FP32 build (see vfwimmacc_vv.h for details).
+auto decode_e8m0_to_f32 = [](uint8_t byte) -> float32_t {
+  if (byte == 0xFF) return (float32_t){ 0x7FC00000u };
+  const int e = (int)byte - 127;
+  uint32_t bits;
+  if (e == -127) {
+    bits = 0x00400000u;
+  } else {
+    bits = ((uint32_t)(e + 127)) << 23;
+  }
+  return (float32_t){ bits };
+};
+
+softfloat_roundingMode = VFP_RM;
+
+// Dispatch by C accumulator format.
+if (sew == 16 && P.VU.altfmt == 0) {
+  // FP16 accumulator (Zvvxi4fp16mm / Zvvxni4fp16mm).
+  auto decode_scale = [&](uint8_t b) -> uint16_t {
+    if (b == 0xFF) return IME_MX_DEFAULT_NAN_FP16;
+    return f32_to_f16(decode_e8m0_to_f32(b)).v;
+  };
+  auto is_nan = [](uint16_t x) -> bool {
+    return (x & 0x7C00) == 0x7C00 && (x & 0x03FF) != 0;
+  };
+  auto fmul = [](uint16_t a, uint16_t b) -> uint16_t {
+    return f16_mul(float16_t{a}, float16_t{b}).v;
+  };
+  auto fadd = [](uint16_t a, uint16_t b) -> uint16_t {
+    return f16_add(float16_t{a}, float16_t{b}).v;
+  };
+  auto itofp = [](int64_t x) -> uint16_t {
+    return i64_to_f16(x).v;
+  };
+  IME_MX_INT_SCALED_GEMM_LOOP(uint16_t, IME_MX_DEFAULT_NAN_FP16,
+                              decode_scale, is_nan, fmul, fadd, itofp);
+} else if (sew == 16) {
+  // BF16 accumulator (Zvvxi4bf16mm / Zvvxni4bf16mm), altfmt = 1.
+  auto decode_scale = [&](uint8_t b) -> uint16_t {
+    if (b == 0xFF) return IME_MX_DEFAULT_NAN_BF16;
+    return f32_to_bf16(decode_e8m0_to_f32(b)).v;
+  };
+  auto is_nan = [](uint16_t x) -> bool {
+    return (x & 0x7F80) == 0x7F80 && (x & 0x007F) != 0;
+  };
+  auto fmul = [](uint16_t a, uint16_t b) -> uint16_t {
+    return bf16_mul(bfloat16_t{a}, bfloat16_t{b}).v;
+  };
+  auto fadd = [](uint16_t a, uint16_t b) -> uint16_t {
+    return bf16_add(bfloat16_t{a}, bfloat16_t{b}).v;
+  };
+  auto itofp = [](int64_t x) -> uint16_t {
+    return i32_to_bf16((int32_t)x).v;
+  };
+  IME_MX_INT_SCALED_GEMM_LOOP(uint16_t, IME_MX_DEFAULT_NAN_BF16,
+                              decode_scale, is_nan, fmul, fadd, itofp);
+} else {
+  // sew == 32, altfmt == 0 -> FP32 (Zvvxi8fp32mm / Zvvxni8fp32mm).
+  auto decode_scale = [&](uint8_t b) -> uint32_t {
+    // E8M0 fits exactly in FP32; no flag is raised in practice, but the
+    // decode routine still returns the FP32 default NaN for 0xFF.
+    return decode_e8m0_to_f32(b).v;
+  };
+  auto is_nan = [](uint32_t x) -> bool {
+    return (x & 0x7F800000u) == 0x7F800000u
+        && (x & 0x007FFFFFu) != 0;
+  };
+  auto fmul = [](uint32_t a, uint32_t b) -> uint32_t {
+    return f32_mul(float32_t{a}, float32_t{b}).v;
+  };
+  auto fadd = [](uint32_t a, uint32_t b) -> uint32_t {
+    return f32_add(float32_t{a}, float32_t{b}).v;
+  };
+  auto itofp = [](int64_t x) -> uint32_t {
+    return i64_to_f32(x).v;
+  };
+  IME_MX_INT_SCALED_GEMM_LOOP(uint32_t, IME_MX_DEFAULT_NAN_FP32,
+                              decode_scale, is_nan, fmul, fadd, itofp);
+}
+
+set_fp_exceptions;
+P.VU.vstart->write(0);
diff --git a/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfwimmacc_vv.h b/toolchains/riscv-tools/riscv-isa-sim/riscv/insns/vfwimmacc_vv.h
