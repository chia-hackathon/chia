   def hazardMultiply(mask: UInt): UInt = if (vParams.hazardingMultiplier == 0) { mask } else {
diff --git a/generators/saturn/src/main/scala/exu/fp/MatrixFPMultiplyPipe.scala b/generators/saturn/src/main/scala/exu/fp/MatrixFPMultiplyPipe.scala
new file mode 100644
index 0000000..c3b9563
--- /dev/null
+++ b/generators/saturn/src/main/scala/exu/fp/MatrixFPMultiplyPipe.scala
@@ -0,0 +1,487 @@
+// Zvvfmm / Zvvfmmx floating-point matrix multiply-accumulates.
+//
+// Handles two arithmetic families in the same FU:
+//
+//   * `vfmmacc.vv`   (funct6 0x14, vm=1): all-FP.  A, B, C ride SEW (= 32 or
+//     64), W = 1.  Two roundings per k under frm --
+//         acc = fp_add(acc, fp_round_to_frm(fp_mul_exact(A, B)))
+//     -- across strictly increasing k.  This is the round-four body.
+//
+//   * `vfwimmacc.vv` / `vfqimmacc.vv` / `vf8wimmacc.vv` (funct6 0x39/0x3a/0x3b,
+//     vm=0): microscaled integer inputs, FP accumulator (Sail `int_scaled_gemm`
+//     5373-5410).  Per (element, block):
+//         dot   := exact_signed_int_sum over k in [k_lo, k_hi] of A[i,k]*B[j,k]
+//         fp    := int_to_fp(dot,  EEW_C, fmt_C, frm)
+//         scale := fp_mul(sA, sB, EEW_C, fmt_C, frm)                          -- from v0
+//         acc   := fp_add(acc, fp_mul(scale, fp, EEW_C, fmt_C, frm), EEW_C, fmt_C, frm)
+//     MXINT inputs are always signed (spec 2335-2342).
+//
+// The sequencer prefetches v0 into `v0_egs` at the start of a microscaled
+// instruction (one micro-op per eg of v0), then walks (i, j, k) as usual.
+// On each block boundary the FU folds the exact integer block dot through
+// fp_mul(scale) + fp_add into the running fp accumulator; on the last k the
+// running accumulator (or the default NaN, if any block scale was NaN) is
+// written back to C[i, j].
+package saturn.exu
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.rocket._
+import freechips.rocketchip.util._
+import freechips.rocketchip.tile._
+import saturn.common._
+import saturn.insns._
+
+case class MatrixFPMultiplyFactory() extends FunctionalUnitFactory {
+  // vfmmacc.vv and the three microscaled forms are elementwise and iterative:
+  // one micro-op per k, and the FU decides when to retire (only at
+  // matrix_last_k does it drive io.write).
+  def insns = IMEInstructions.fpMatrixArithInsns.map(_.elementWise.iterative)
+  def generate(implicit p: Parameters) = new MatrixFPMultiplyPipe()(p)
+}
+
+class MatrixFPMultiplyPipe(implicit p: Parameters) extends IterativeFunctionalUnit()(p) {
+  io.set_vxsat := false.B
+  io.scalar_write.valid := false.B
+  io.scalar_write.bits := DontCare
+  io.acc := false.B
+
+  // Distinguish the microscaled integer-input path (funct6 0x39/0x3a/0x3b,
+  // vm=0) from vfmmacc.vv (funct6 0x14, vm=1).  vm alone is enough: on this
+  // FU only these two families ever arrive, and only the microscaled ones
+  // have vm=0.
+  val is_scaled = op.matrix_scaled
+
+  // Per-operand element widths.
+  //   vfmmacc.vv     : rvs1_eew = rvs2_eew = vd_eew = SEW (W = 1).
+  //   microscaled    : rvs1_eew = rvs2_eew = EEW_AB = SEW / W;
+  //                    vd_eew = SEW (C stays at the accumulator width).
+  val sew_a = op.rvs1_eew
+  val sew_b = op.rvs2_eew
+  val sew_c = op.vd_eew
+
+  val a_elem_idx = op.matrix_a_pos >> sew_a
+  val b_elem_idx = op.matrix_b_pos >> sew_b
+  val c_elem_idx = op.matrix_c_pos >> sew_c
+
+  // Extract A, B, C from the dLen-wide micro-op data streams.  The extracted
+  // value is width-normalized to 64 bits.
+  val a_raw = extractElem(op.rvs1_data, sew_a, a_elem_idx)(63, 0)
+  val b_raw = extractElem(op.rvs2_data, sew_b, b_elem_idx)(63, 0)
+  val c_raw = extractElem(op.rvd_data,  sew_c, c_elem_idx)(63, 0)
+
+  // sew_c selects the C accumulator FP format:
+  //   sew_c = 1 -> binary16 (FType.H)  when matrix_altfmt = 0
+  //             -> BFloat16  (FType(8,8)) when matrix_altfmt = 1
+  //   sew_c = 2 -> binary32 (FType.S)
+  //   sew_c = 3 -> binary64 (FType.D)
+  val is_h    = sew_c === 1.U
+  val is_s    = sew_c === 2.U
+  val is_d    = sew_c === 3.U
+  val is_bf16 = is_h && op.matrix_altfmt
+  val is_h16  = is_h && !op.matrix_altfmt
+  val BF16    = new FType(8, 8)
+
+  // -------------------- vfmmacc.vv (FP) path --------------------------------
+  // Recode the raw IEEE bits for FP32 / FP64.  Only the FType matching sew_c
+  // will actually feed a live path this cycle.
+  val a_s = FType.S.recode(a_raw(31, 0))
+  val b_s = FType.S.recode(b_raw(31, 0))
+  val a_d = FType.D.recode(a_raw)
+  val b_d = FType.D.recode(b_raw)
+
+  // FP accumulator, kept alive across k for one (i, j) cell.  Stored in raw
+  // IEEE form.  RegInit rather than Reg so that Verilator RANDOMIZE_REG_INIT
+  // cannot seed a NaN pattern into the FP add's second-operand path on
+  // cycle 0.
+  //
+  // For the microscaled path this same register holds the running FP
+  // accumulator across microscaling blocks within one (i, j) cell.  On the
+  // first block_last of a cell the accumulator is initialized from C[i, j];
+  // subsequent blocks fold their scaled sum into it, and matrix_last_k
+  // writes the final value back to the register file.
+  val acc_reg    = RegInit(0.U(64.W))
+  val valid_prev = RegNext(valid, false.B)
+
+  // NaN latch for microscaled path.  Cleared at matrix_first_k, set the
+  // first time we see a NaN block scale within an (i, j) cell.  On
+  // matrix_last_k we emit the default NaN of fmt_C rather than the running
+  // fp acc when this bit is set.
+  val nan_out_reg = RegInit(false.B)
+
+  // Multiplier: p = fp_round_to_frm(fp_mul_exact(A, B)) for the FP path.
+  val mul_s = Module(new hardfloat.MulRecFN(FType.S.exp, FType.S.sig))
+  mul_s.io.a := a_s
+  mul_s.io.b := b_s
+  mul_s.io.roundingMode := op.frm
+  mul_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  val mul_d = Module(new hardfloat.MulRecFN(FType.D.exp, FType.D.sig))
+  mul_d.io.a := a_d
+  mul_d.io.b := b_d
+  mul_d.io.roundingMode := op.frm
+  mul_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  // -------------------- Microscaled integer path ----------------------------
+  // A, B read as signed integers at EEW_AB bits (EEW_AB = SEW / W).  MXINT is
+  // signed unconditionally, so we ignore matrix_altfmt_{A,B} on this path.
+  // sew_a and sew_b encode EEW_AB, where 0 -> INT8, 1 -> INT16, etc.
+  //
+  // For INT4 (op.matrix_int4 = true): the sequencer clamped rvs1_eew /
+  // rvs2_eew to 0 (byte read) and set matrix_a_nib_hi / matrix_b_nib_hi to
+  // pick the low or high 4-bit nibble in that byte.  Sign-extend the nibble
+  // from its top bit to 64 bits.  Sequencer also uses byte-level eg
+  // computation for INT4, so a_raw is the byte holding two INT4 elements.
+  //
+  // For non-INT4: sign-extend the extracted A/B element from its EEW_AB
+  // width up to 64 bits.  MuxLookup does not accept SInt values; use a Vec
+  // of 64-bit signed sign-extensions indexed by sew_a / sew_b.
+  val a_nib     = Mux(op.matrix_a_nib_hi, a_raw(7, 4), a_raw(3, 0))
+  val a_int4_ext = Cat(Fill(60, a_nib(3)), a_nib)
+  val a_int_full = VecInit(Seq(
+    Cat(Fill(56, a_raw(7)),  a_raw(7, 0)),
+    Cat(Fill(48, a_raw(15)), a_raw(15, 0)),
+    Cat(Fill(32, a_raw(31)), a_raw(31, 0)),
+    a_raw
+  ))(sew_a)
+  val a_int_e = Mux(op.matrix_int4, a_int4_ext, a_int_full).asSInt
+
+  val b_nib     = Mux(op.matrix_b_nib_hi, b_raw(7, 4), b_raw(3, 0))
+  val b_int4_ext = Cat(Fill(60, b_nib(3)), b_nib)
+  val b_int_full = VecInit(Seq(
+    Cat(Fill(56, b_raw(7)),  b_raw(7, 0)),
+    Cat(Fill(48, b_raw(15)), b_raw(15, 0)),
+    Cat(Fill(32, b_raw(31)), b_raw(31, 0)),
+    b_raw
+  ))(sew_b)
+  val b_int_e = Mux(op.matrix_int4, b_int4_ext, b_int_full).asSInt
+
+  // Integer product.  For INT8*INT8 the true product fits in 16 bits; the
+  // 64-bit signed multiplier below produces its correct sign-extension.
+  val int_product = (a_int_e * b_int_e).asSInt
+
+  // Integer accumulator, alive across k within one block.  Reset on
+  // matrix_block_first (which equals matrix_first_k on block 0).  We size it
+  // at 40 bits to safely accumulate INT8*INT8 over one block_size (<= 32).
+  val int_acc_reg = RegInit(0.S(40.W))
+  val int_first   = op.matrix_block_first
+  val int_running = Mux(int_first, 0.S(40.W), int_acc_reg)
+  // Truncate the product to 40 bits before adding to keep widths bounded.
+  val int_product_40 = int_product(39, 0).asSInt
+  val int_next_wide  = int_running +& int_product_40
+  val int_next       = int_next_wide(39, 0).asSInt
+
+  // At matrix_block_last the running sum plus the current product is the
+  // block dot.  This is what feeds INToRecFN below.
+  val int_sum_final = int_next
+
+  // Advance int_acc across k except on block-boundary cycles.  At block_last
+  // we consume int_next directly (into fp_sum), and the next block's first
+  // cycle resets from 0 via the int_first mux, so there's no correctness
+  // dependence on int_acc_reg after block_last.  Prefetch cycles don't
+  // touch the integer accumulator.
+  when (valid && !valid_prev && is_scaled && !op.matrix_scale_prefetch && !op.matrix_block_last) {
+    int_acc_reg := int_next
+  }
+
+  // int_to_fp: convert int_sum_final to the SEW-wide FP format.  Because we
+  // truncated the running sum to 40 bits, its low 32 bits are meaningful
+  // only when the true value fits in signed 32 bits; for larger sums (which
+  // rarely arise in the tests we chase this round) the FP conversion will
+  // saturate anyway once it goes through INToRecFN.
+  val int_sum_32 = int_sum_final(31, 0)
+
+  val i2h = Module(new hardfloat.INToRecFN(32, FType.H.exp, FType.H.sig))
+  i2h.io.in := int_sum_32
+  i2h.io.signedIn := true.B
+  i2h.io.roundingMode := op.frm
+  i2h.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  val i2s = Module(new hardfloat.INToRecFN(32, FType.S.exp, FType.S.sig))
+  i2s.io.in := int_sum_32
+  i2s.io.signedIn := true.B
+  i2s.io.roundingMode := op.frm
+  i2s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  // 64-bit inputs to keep hardfloat happy with standard widths.  Sign-extend
+  // the 40-bit accumulator up to 64 bits.
+  val int_sum_64 = Cat(Fill(24, int_sum_final(39)), int_sum_final.asUInt)
+  val i2d = Module(new hardfloat.INToRecFN(64, FType.D.exp, FType.D.sig))
+  i2d.io.in := int_sum_64
+  i2d.io.signedIn := true.B
+  i2d.io.roundingMode := op.frm
+  i2d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  // -------------------- v0 prefetch cache & scale extraction ----------------
+  // The sequencer walks matrix_scale_prefetch_eg = 0 .. egsPerVReg-1 before
+  // starting the (i, j, k) walk on a microscaled instruction; on each of
+  // those cycles op.rvm_data is one eg of v0.  Latch them here.
+  //
+  // v0 is dLen-wide per eg, egsPerVReg egs total.  Concatenated (elem 0 is
+  // LSB), it holds VLEN/16 paired-scale 16-bit elements.  A pair at index p
+  // (matrix_pair_[ab]_idx) has scale_A in its lower 8 bits and scale_B in
+  // its upper 8 bits (spec 2132-2133).
+  val v0_egs = Reg(Vec(egsPerVReg, UInt(dLen.W)))
+  when (valid && !valid_prev && is_scaled && op.matrix_scale_prefetch) {
+    v0_egs(op.matrix_scale_prefetch_eg) := op.rvm_data
+  }
+  val v0_bits  = v0_egs.asUInt                                // vLen wide, elem 0 LSB
+  val v0_pairs = v0_bits.asTypeOf(Vec(vLen / 16, UInt(16.W)))
+  val pair_a   = v0_pairs(op.matrix_pair_a_idx)
+  val pair_b   = v0_pairs(op.matrix_pair_b_idx)
+  val sA_byte  = pair_a(7, 0)     // lower byte of pair
+  val sB_byte  = pair_b(15, 8)    // upper byte of pair
+
+  // E8M0 -> FP conversion.  For byte in [0, 254] the encoded value is
+  // 2^(byte - 127); byte = 0xFF is NaN.  The E8M0 exponent field maps
+  // directly to the FP32 exponent (both 8 bits, unbiased in the same way):
+  // for a non-NaN, non-zero E8M0 value byte, the FP32 encoding of the same
+  // 2^(byte - 127) power of two is Cat(byte, 0.U(23.W)), which is exactly
+  // `byte << 23`.  For binary16 / bfloat16 / binary64 we go via FP32 first
+  // and then convert with RecFNToRecFN (safe because the input is always a
+  // power of two, hence exactly representable in any binary FP format).
+  //
+  // Byte = 0xFF: bit pattern (byte << 23) is +Infinity in FP32; we track
+  // NaN separately via the raw byte comparison.
+  val sA_is_nan = sA_byte === 0xFF.U(8.W)
+  val sB_is_nan = sB_byte === 0xFF.U(8.W)
+
+  // FP32 has 1 sign + 8 exp + 23 frac = 32 bits.  Non-NaN E8M0 is positive,
+  // so sign = 0; exponent field = the E8M0 byte; fraction = 0.
+  val sA_fp32_bits = Cat(0.U(1.W), sA_byte, 0.U(23.W))
+  val sB_fp32_bits = Cat(0.U(1.W), sB_byte, 0.U(23.W))
+  val sA_s = FType.S.recode(sA_fp32_bits)
+  val sB_s = FType.S.recode(sB_fp32_bits)
+
+  // Block scale = fp_mul(sA, sB).  Compute per-format.
+  val blk_scale_mul_s = Module(new hardfloat.MulRecFN(FType.S.exp, FType.S.sig))
+  blk_scale_mul_s.io.a := sA_s
+  blk_scale_mul_s.io.b := sB_s
+  blk_scale_mul_s.io.roundingMode := op.frm
+  blk_scale_mul_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val blk_scale_s = blk_scale_mul_s.io.out
+
+  // For FP16 (binary16), convert sA and sB from FP32 to FP16 first, then
+  // multiply in FP16.  Since sA / sB are exact powers of two, the
+  // conversion is exact (except when the exponent overflows FP16's range,
+  // in which case the result is +/-inf; we accept whatever hardfloat
+  // rounds to).
+  val sA_to_h = Module(new hardfloat.RecFNToRecFN(FType.S.exp, FType.S.sig, FType.H.exp, FType.H.sig))
+  sA_to_h.io.in := sA_s
+  sA_to_h.io.roundingMode := op.frm
+  sA_to_h.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val sB_to_h = Module(new hardfloat.RecFNToRecFN(FType.S.exp, FType.S.sig, FType.H.exp, FType.H.sig))
+  sB_to_h.io.in := sB_s
+  sB_to_h.io.roundingMode := op.frm
+  sB_to_h.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val blk_scale_mul_h = Module(new hardfloat.MulRecFN(FType.H.exp, FType.H.sig))
+  blk_scale_mul_h.io.a := sA_to_h.io.out
+  blk_scale_mul_h.io.b := sB_to_h.io.out
+  blk_scale_mul_h.io.roundingMode := op.frm
+  blk_scale_mul_h.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val blk_scale_h = blk_scale_mul_h.io.out
+
+  // FP64.
+  val sA_to_d = Module(new hardfloat.RecFNToRecFN(FType.S.exp, FType.S.sig, FType.D.exp, FType.D.sig))
+  sA_to_d.io.in := sA_s
+  sA_to_d.io.roundingMode := op.frm
+  sA_to_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val sB_to_d = Module(new hardfloat.RecFNToRecFN(FType.S.exp, FType.S.sig, FType.D.exp, FType.D.sig))
+  sB_to_d.io.in := sB_s
+  sB_to_d.io.roundingMode := op.frm
+  sB_to_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val blk_scale_mul_d = Module(new hardfloat.MulRecFN(FType.D.exp, FType.D.sig))
+  blk_scale_mul_d.io.a := sA_to_d.io.out
+  blk_scale_mul_d.io.b := sB_to_d.io.out
+  blk_scale_mul_d.io.roundingMode := op.frm
+  blk_scale_mul_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val blk_scale_d = blk_scale_mul_d.io.out
+
+  // scaled_sum = fp_mul(blk_scale, fp_sum(int_dot))
+  // -- one per output format.
+  val scaled_mul_h = Module(new hardfloat.MulRecFN(FType.H.exp, FType.H.sig))
+  scaled_mul_h.io.a := blk_scale_h
+  scaled_mul_h.io.b := i2h.io.out
+  scaled_mul_h.io.roundingMode := op.frm
+  scaled_mul_h.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  val scaled_mul_s = Module(new hardfloat.MulRecFN(FType.S.exp, FType.S.sig))
+  scaled_mul_s.io.a := blk_scale_s
+  scaled_mul_s.io.b := i2s.io.out
+  scaled_mul_s.io.roundingMode := op.frm
+  scaled_mul_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  val scaled_mul_d = Module(new hardfloat.MulRecFN(FType.D.exp, FType.D.sig))
+  scaled_mul_d.io.a := blk_scale_d
+  scaled_mul_d.io.b := i2d.io.out
+  scaled_mul_d.io.roundingMode := op.frm
+  scaled_mul_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+
+  // Adder input:
+  //   FP path (is_scaled = 0): on first_k the accumulator starts from
+  //     C[i,j]; on subsequent k we feed the running acc_reg back in.  This
+  //     folds the mul-and-round result into the running fp acc each k.
+  //   Microscaled (is_scaled = 1) at block_last:
+  //     * matrix_first_block: acc starts from C[i,j];
+  //     * subsequent blocks:  acc starts from acc_reg.
+  //     block_first_k for FP path == matrix_first_k.
+  val acc_input_fp     = Mux(op.matrix_first_k, c_raw, acc_reg)
+  val acc_input_scaled = Mux(op.matrix_first_block, c_raw, acc_reg)
+  val acc_input        = Mux(is_scaled, acc_input_scaled, acc_input_fp)
+
+  // Adder second operand:
+  //   FP path (is_scaled = 0)  -> mul.io.out (rounded product)
+  //   microscaled (is_scaled = 1) -> scaled_mul_*.io.out (blk_scale * fp_sum)
+  val add_h_b = Mux(is_scaled, scaled_mul_h.io.out, i2h.io.out)
+  val add_s_b = Mux(is_scaled, scaled_mul_s.io.out, mul_s.io.out)
+  val add_d_b = Mux(is_scaled, scaled_mul_d.io.out, mul_d.io.out)
+
+  val add_h = Module(new hardfloat.AddRecFN(FType.H.exp, FType.H.sig))
+  add_h.io.subOp := false.B
+  add_h.io.a := FType.H.recode(acc_input(15, 0))
+  add_h.io.b := add_h_b
+  add_h.io.roundingMode := op.frm
+  add_h.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val new_acc_h_ieee = FType.H.ieee(add_h.io.out)
+
+  // BFloat16 (exp=8, sig=8) path.  hardfloat's AddRecFN needs
+  // sigWidth >= 11, so route bfloat16 through FP32:
+  //   * The int->fp side uses i2s (INToRecFN with FP32 target) which is
+  //     already exact for our int accumulator.
+  //   * The C bfloat16 value is bitwise the top 16 bits of a binary32
+  //     value, so BF16->FP32 = zero-extend on the right.
+  //   * We reuse a dedicated AddRecFN(FP32) so as not to disturb the
+  //     vfmmacc.vv path's shared adder.  Its output is then rounded back
+  //     to BF16 with RecFNToRecFN.
+  //   * For the microscaled path we scale in FP32 (using i2s and
+  //     blk_scale_s) then add; the same fp32-add + round-back-to-bf16
+  //     structure applies.
+  val c_bf_as_fp32 = Cat(acc_input(15, 0), 0.U(16.W))
+  // Scaled sum in FP32 for the bfloat16 microscaled path.
+  val scaled_mul_bf = Module(new hardfloat.MulRecFN(FType.S.exp, FType.S.sig))
+  scaled_mul_bf.io.a := blk_scale_s
+  scaled_mul_bf.io.b := i2s.io.out
+  scaled_mul_bf.io.roundingMode := op.frm
+  scaled_mul_bf.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val add_bf_s = Module(new hardfloat.AddRecFN(FType.S.exp, FType.S.sig))
+  add_bf_s.io.subOp := false.B
+  add_bf_s.io.a := FType.S.recode(c_bf_as_fp32)
+  add_bf_s.io.b := Mux(is_scaled, scaled_mul_bf.io.out, i2s.io.out)
+  add_bf_s.io.roundingMode := op.frm
+  add_bf_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val bf_s_round = Module(new hardfloat.RecFNToRecFN(FType.S.exp, FType.S.sig, BF16.exp, BF16.sig))
+  bf_s_round.io.in := add_bf_s.io.out
+  bf_s_round.io.roundingMode := op.frm
+  bf_s_round.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val new_acc_bf_ieee = BF16.ieee(bf_s_round.io.out)
+
+  val add_s = Module(new hardfloat.AddRecFN(FType.S.exp, FType.S.sig))
+  add_s.io.subOp := false.B
+  add_s.io.a := FType.S.recode(acc_input(31, 0))
+  add_s.io.b := add_s_b
+  add_s.io.roundingMode := op.frm
+  add_s.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val new_acc_s_ieee = FType.S.ieee(add_s.io.out)
+
+  val add_d = Module(new hardfloat.AddRecFN(FType.D.exp, FType.D.sig))
+  add_d.io.subOp := false.B
+  add_d.io.a := FType.D.recode(acc_input)
+  add_d.io.b := add_d_b
+  add_d.io.roundingMode := op.frm
+  add_d.io.detectTininess := hardfloat.consts.tininess_afterRounding
+  val new_acc_d_ieee = FType.D.ieee(add_d.io.out)
+
+  // Select the SEW-wide result.  For SEW=16 the low 16 bits carry the
+  // binary16 or bfloat16 payload (per matrix_altfmt); higher lanes are
+  // ignored by the write mask.
+  val new_acc_h_pick = Mux(is_bf16, new_acc_bf_ieee, new_acc_h_ieee)
+  val new_acc_fp = Mux(is_d, new_acc_d_ieee,
+                   Mux(is_s, Cat(0.U(32.W), new_acc_s_ieee),
+                             Cat(0.U(48.W), new_acc_h_pick)))
+
+  // Default NaN encoding per FP format (spec fp_defaultNaN):
+  //   binary16 : 0x7E00
+  //   bfloat16 : 0x7FC0
+  //   binary32 : 0x7FC0_0000
+  //   binary64 : 0x7FF8_0000_0000_0000
+  val default_nan_h  = 0x7E00.U(64.W)
+  val default_nan_bf = 0x7FC0.U(64.W)
+  val default_nan_s  = 0x7FC00000L.U(64.W)
+  val default_nan_d  = BigInt("7FF8000000000000", 16).U(64.W)
+  val default_nan    = Mux(is_d, default_nan_d,
+                       Mux(is_s, default_nan_s,
+                       Mux(is_bf16, default_nan_bf, default_nan_h)))
+
+  // The current block's fold result.  On block_last cycles this is either
+  // the newly-added fp_acc (folding scaled_sum in) or the default NaN when
+  // the block scale itself is NaN.  We also update nan_out_reg here for
+  // subsequent blocks to short-circuit through the same NaN.
+  val cur_blk_scale_nan = is_scaled && sA_is_nan || sB_is_nan
+  // Combined-scale NaN is what governs; sA_byte = 0xFF OR sB_byte = 0xFF
+  // is the shortcut (per E8M0 rules the combined scale is NaN iff either
+  // encoded scale is NaN).
+  val cur_blk_nan = is_scaled && (sA_is_nan || sB_is_nan)
+  val fp_next_block = Mux(cur_blk_nan || nan_out_reg, default_nan, new_acc_fp)
+
+  // Track NaN across blocks: cleared at matrix_first_k, sticky on cur_blk_nan
+  // at block_last.
+  when (valid && !valid_prev && is_scaled && !op.matrix_scale_prefetch) {
+    when (op.matrix_first_k) {
+      nan_out_reg := false.B
+    }
+    when (op.matrix_block_last && cur_blk_nan) {
+      nan_out_reg := true.B
+    }
+  }
+
+  // For the microscaled path we retire the FP add only at matrix_last_k.
+  // Between block boundaries we hold the running fp acc in acc_reg.  On a
+  // NaN-affected element, fp_next_block already carries the default NaN,
+  // so writing that at matrix_last_k gives the correct spec behavior.
+  //
+  // For vfmmacc.vv (is_scaled = 0) the existing per-k folding is unchanged.
+  val fp_next_when_scaled = Mux(op.matrix_last_k, fp_next_block, c_raw)
+  val new_acc = Mux(is_scaled, fp_next_when_scaled, new_acc_fp)
+
+  when (valid && !valid_prev && !op.matrix_last_k) {
+    when (!is_scaled) {
+      // FP path: fold the product into the accumulator every k except last.
+      acc_reg := new_acc_fp
+    } .elsewhen (is_scaled && !op.matrix_scale_prefetch && op.matrix_block_last) {
+      // Microscaled: fold this block's scaled sum into the running fp acc.
+      // fp_next_block already accounts for NaN scales.
+      acc_reg := fp_next_block
+    }
+  }
+
+  // Truncate / replicate the accumulator across the dLen chunk; the write
+  // mask (mat_wmask, one SEW-wide slot) picks the right byte lane.
+  val result_replicated = dLenSplat(new_acc, sew_c)
+
+  // Do NOT write on prefetch cycles -- those only cache v0 into v0_egs.
+  io.write.valid     := valid && op.matrix_last_k && !op.matrix_scale_prefetch
+  io.write.bits.eg   := op.wvd_eg
+  io.write.bits.data := result_replicated
+  io.write.bits.mask := FillInterleaved(8, op.wmask)
+
+  io.hazard.valid    := valid
+  io.hazard.bits.eg  := op.wvd_eg
+  io.hazard.bits.vat := op.vat
+
+  io.tail := op.tail
+
+  // fflags reporting is intentionally disabled -- the .vf S2 regression is
+  // sensitive to driving them across the shared int/fp writeback path.
+  io.set_fflags.valid := false.B
+  io.set_fflags.bits  := DontCare
+
+  // Prefetch cycles retire in a single tick (no write, no accumulate).
+  // Compute cycles retire on matrix_last_k when io.write fires, else in a
+  // single tick.
+  last := Mux(op.matrix_scale_prefetch, valid,
+          Mux(op.matrix_last_k, io.write.fire, valid))
+
+  // The matrix FU stalls the shared int/fp issue path only via `valid`.
+  io.stall := valid
+}
diff --git a/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala b/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala
new file mode 100644
index 0000000..8cedddd
--- /dev/null
+++ b/generators/saturn/src/main/scala/exu/int/MatrixMultiplyPipe.scala
@@ -0,0 +1,132 @@
+// Zvvm Integer Matrix Multiply-Accumulate: vmmacc.vv and vqmmacc.vv.
+//
+// Both instructions walk the same (j, i, k) sequence; each iteration
+// produces one A * B product and folds it into the running C accumulator.
+// The only per-instruction difference is the width of A and B:
+//
+//   vmmacc.vv  (W=1)  reads A, B, C all at SEW.
+//   vqmmacc.vv (W=4)  reads A, B at EEW_A = SEW/4 and C at SEW.
+//
+// The ExecuteSequencer has already selected the right widths -- rvs1_eew /
+// rvs2_eew carry EEW_A, vd_eew carries EEW_C -- so this FU never needs to
+// know W directly.  A 64-bit signed multiply is enough for either operand
+// pair: an EEW_A x EEW_A product fits in <= 2*EEW_A <= SEW <= 64 bits after
+// sign extension.
+package saturn.exu
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.rocket._
+import freechips.rocketchip.util._
+import freechips.rocketchip.tile._
+import saturn.common._
+import saturn.insns._
+
+case class MatrixMultiplyFactory() extends FunctionalUnitFactory {
+  def insns = IMEInstructions.matrixArithInsns.map(_.elementWise.iterative)
+  def generate(implicit p: Parameters) = new MatrixMultiplyPipe()(p)
+}
+
+class MatrixMultiplyPipe(implicit p: Parameters) extends IterativeFunctionalUnit()(p) {
+  io.set_vxsat := false.B
+  io.set_fflags.valid := false.B
+  io.set_fflags.bits := DontCare
+  io.scalar_write.valid := false.B
+  io.scalar_write.bits := DontCare
+  io.acc := false.B
+
+  // Per-operand element widths.  For vmmacc.vv all three are equal to SEW;
+  // for vqmmacc.vv the sequencer sets rvs1_eew = rvs2_eew = SEW/4 and leaves
+  // vd_eew at SEW.  matrix_a_pos / matrix_b_pos / matrix_c_pos are byte
+  // positions within the dLen chunk carried by rvs1_data / rvs2_data /
+  // rvd_data respectively, so dividing by the operand's element size in
+  // bytes recovers the in-chunk element index.
+  val sew_a = op.rvs1_eew
+  val sew_b = op.rvs2_eew
+  val sew_c = op.vd_eew
+
+  val a_elem_idx = op.matrix_a_pos >> sew_a
+  val b_elem_idx = op.matrix_b_pos >> sew_b
+  val c_elem_idx = op.matrix_c_pos >> sew_c
+
+  val a_raw = extractElem(op.rvs1_data, sew_a, a_elem_idx)(63, 0)
+  val b_raw = extractElem(op.rvs2_data, sew_b, b_elem_idx)(63, 0)
+  val c_raw = extractElem(op.rvd_data,  sew_c, c_elem_idx)(63, 0)
+
+  def signExtend(elem: UInt, sewSel: UInt, signed: Bool): SInt = {
+    VecInit.tabulate(4)({ eew =>
+      val w = 8 << eew
+      if (w >= 64) elem(63, 0)
+      else Cat(Fill(64 - w, signed && elem(w - 1)), elem(w - 1, 0))
+    })(sewSel).asSInt
+  }
+
+  // altfmt selects operand signedness: 0 = signed, 1 = unsigned.  A/B extend
+  // at their own EEW (which is SEW/W); C extends at SEW.  The extended
+  // 64-bit signed values then feed a plain 64-bit signed multiplier -- the
+  // low SEW bits of the product are correct regardless of whether the true
+  // product fits in 64 bits, because two SEW/W-wide inputs give at most a
+  // 2*SEW/W-bit product and 2*SEW/W <= SEW <= 64 for every legal geometry.
+  val a_ext = signExtend(a_raw, sew_a, !op.matrix_altfmt_A)
+  val b_ext = signExtend(b_raw, sew_b, !op.matrix_altfmt_B)
+  val c_ext = signExtend(c_raw, sew_c, true.B).asUInt
+
+  val product = (a_ext * b_ext).asUInt
+
+  // Explicit two-Reg design: capture c_ext at first_k, then accumulate
+  // products separately. At last_k, WRITE = c_captured + prev_product_sum +
+  // current_product. This eliminates the force_first Mux path where a Reg
+  // update race could contaminate matrix_acc with residual state from the
+  // previous cell.
+  val c_ext_captured = Reg(UInt(64.W))
+  val product_sum    = RegInit(0.U(64.W))
+  val valid_prev     = RegNext(valid, false.B)
+
+  when (valid && !valid_prev) {
+    when (op.matrix_first_k) {
+      c_ext_captured := c_ext
+      product_sum    := product(63, 0)
+    } .elsewhen (!op.matrix_last_k) {
+      // Skip accumulating at last_k. new_acc already includes current
+      // product via the direct add; updating product_sum here creates a
+      // race if write.ready is ever low at last_k (valid stays high a
+      // second cycle, and new_acc would then double-add the current
+      // product).
+      product_sum    := (product_sum +& product(63, 0))(63, 0)
+    }
+  }
+
+  // At the last_k write cycle, the current iter's product hasn't been folded
+  // into product_sum yet (Reg update happens at posedge). So compute:
+  //   result = c_captured + product_sum + product(current)
+  // For a K=1 cell (first_k == last_k), c_captured / product_sum still hold
+  // the PREVIOUS cell's values at the write moment. Handle by using c_ext /
+  // 0 in that case.
+  val use_first    = op.matrix_first_k
+  val write_c      = Mux(use_first, c_ext,   c_ext_captured)
+  val write_prev_s = Mux(use_first, 0.U(64.W), product_sum)
+  val new_acc      = (write_c +& write_prev_s +& product(63, 0))(63, 0)
+
+  // Truncate the accumulator back to SEW bits and splat -- the wmask below
+  // gates which byte lane actually lands.
+  val result_sew = VecInit.tabulate(4)({ eew =>
+    new_acc((8 << eew) - 1, 0)
+  })(sew_c)
+  val result_replicated = dLenSplat(result_sew, sew_c)
+
+  io.write.valid     := valid && op.matrix_last_k
+  io.write.bits.eg   := op.wvd_eg
+  io.write.bits.data := result_replicated
+  io.write.bits.mask := FillInterleaved(8, op.wmask)
+
+  io.hazard.valid    := valid
+  io.hazard.bits.eg  := op.wvd_eg
+  io.hazard.bits.vat := op.vat
+
+  io.tail := op.tail
+
+  last := Mux(op.matrix_last_k, io.write.fire, valid)
+
+  io.stall := valid
+}
