+++ b/generators/saturn/src/main/scala/frontend/Dispatch.scala
@@ -125,6 +125,47 @@ class VectorDispatcher(implicit p: Parameters) extends CoreModule()(p) with HasV
   io.mem.bits.fast_sg := issue_inst.fast_sg
   io.mem.bits.debug_id := issue_inst.debug_id
 
+  // Zvvm IME tile load/store macro-op population.
+  //   linesize = LAMBDA * LMUL, in SEW-wide elements.
+  //   ld_bytes = rs2 * (SEW/8) when rs2 != 0.  When rs2 == 0 the spec
+  //   default depends on the variant:
+  //     order-preserving (vmtl.v / vmts.v): elems_per_reg / lambda =
+  //                                          (VLEN/SEW) / LAMBDA
+  //     transposing     (vmttl.v / vmtts.v): VLEN / (SEW * LAMBDA)
+  //   Both equal (VLEN/SEW)/LAMBDA elements = M, so they are algebraically
+  //   identical.  We compute log2(default LD in elements) = log2L - lambda_log2
+  //   for both, then shift into bytes.  (The comment in the pre-round-three
+  //   file claimed "LAMBDA*LMUL*(SEW/8)" but that was the linesize, not the
+  //   spec default LD.  The existing tests always emit a non-zero LD, so the
+  //   old expression was dead code.)
+  //
+  // For the lambda encoding, tile_lambda_imm != 0 selects the immediate,
+  // otherwise vtype.lambda is used.  Both encode LAMBDA = 2^(enc-1) for
+  // enc in 1..7. The log2 of LAMBDA is (enc - 1); log2 of LAMBDA*LMUL is
+  // (enc - 1) + vlmul_mag (vlmul_mag is the LMUL log2 for integer LMUL).
+  val tile_lambda_enc = Mux(issue_inst.tile_lambda_imm =/= 0.U,
+                             issue_inst.tile_lambda_imm,
+                             issue_inst.vconfig.vtype.lambda)
+  val tile_lambda_log2 = Mux(tile_lambda_enc === 0.U, 0.U(3.W),
+                              (tile_lambda_enc - 1.U)(2, 0))
+  val tile_lmul_log2   = issue_inst.vconfig.vtype.vlmul_mag
+  val tile_linesize_log2 = (tile_lambda_log2 +& tile_lmul_log2)(2, 0)
+  val tile_sew_bytes_log2 = issue_inst.vconfig.vtype.vsew(1,0)
+  // log2(VLEN/SEW) = log2(VLEN) - 3 - vsew.
+  val tile_log2L = (log2Ceil(vLen).U(5.W) - 3.U - tile_sew_bytes_log2)(3, 0)
+  // Default LD in *elements* = M = (VLEN/SEW)/LAMBDA.  Same formula for both
+  // variants (see comment above).  Shift into bytes by adding sew_bytes_log2.
+  val tile_default_ld_log2 = (tile_log2L - tile_lambda_log2)(3, 0)
+  val tile_default_ld_bytes = (1.U << (tile_default_ld_log2 +& tile_sew_bytes_log2))
+  val tile_ld_bytes = Mux(issue_inst.rs2_data === 0.U,
+                          tile_default_ld_bytes,
+                          (issue_inst.rs2_data << tile_sew_bytes_log2))
+  io.mem.bits.is_tile := issue_inst.is_tile_op
+  io.mem.bits.is_tile_transposing := issue_inst.is_tile_transposing_op
+  io.mem.bits.tile_linesize_log2 := tile_linesize_log2
+  io.mem.bits.tile_lambda_log2 := tile_lambda_log2
+  io.mem.bits.tile_ld_bytes := tile_ld_bytes(pgIdxBits-1, 0)
+
 
   for (r <- io.vat_release) {
     when (r.valid) {
