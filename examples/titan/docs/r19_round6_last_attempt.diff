+// Signedness of A and B is selected by altfmt_A / altfmt_B (0 = signed,
+// 1 = unsigned). C is always signed.
+const bool signed_A = (P.VU.ime_altfmt_A == 0);
+const bool signed_B = (P.VU.ime_altfmt_B == 0);
