+      (L.toLong % lam2 == 0L) && Set(1L,2L,4L,8L,16L).contains(L.toLong / lam2)
+    }
+  }
+
+  // Returns a Vec[7](Bool) telling whether each nonzero encoding (1..7)
+  // is legal for the given sewIdx (0..3 -> SEW 8,16,32,64) at the current
+  // implementation VLEN.  Values outside 0..3 are treated as illegal.
+  def imeLambdaLegalVec(sewIdx: UInt): Vec[Bool] = {
+    val vlenBits = maxVLMax        // maxVLMax numerically equals VLEN (bits) at LMUL_max=8 SEW_min=8
+    val perSew: Seq[Seq[Bool]] = (0 until 4).map { s =>
+      val sewBits = 8 << s
+      (1 to 7).map(enc => imeLegalLambdaStatic(enc, vlenBits, sewBits).B)
+    }
+    val vec = VecInit(perSew.map(row => VecInit(row)))
+    val safeSew = Mux(sewIdx < 4.U, sewIdx(1, 0), 0.U(2.W))
+    vec(safeSew)
+  }
+
+  // WARL processing for a lambda write request.
+  //   - a nonzero request that is supported is retained
+  //   - a nonzero request that is not supported is clamped to the largest
+  //     supported value <= request, or to the smallest supported value if
+  //     no supported value is <= request
+  //   - a zero request (or vsetvli/vsetivli) preserves the current lambda
+  //     if still supported; otherwise selects the largest supported lambda
+  //   - if no lambda is supported for (VLEN, sew), the field is set to 000
+  def imeWarlLambda(request_enc: UInt, cur_enc: UInt, new_vsew: UInt,
+                    is_nonzero_request: Bool): UInt = {
+    val legal = imeLambdaLegalVec(new_vsew)
+    val candidate = Mux(is_nonzero_request, request_enc, cur_enc)
+    val cand_nz = candidate =/= 0.U
+    val cand_is_legal = cand_nz && legal(Mux(cand_nz, candidate - 1.U, 0.U))
+
+    val encs = (1 to 7)
+    val largest_legal = encs.reverse.foldLeft(0.U(3.W)) { (acc, e) =>
+      Mux(acc === 0.U && legal(e - 1), e.U(3.W), acc)
+    }
+    val smallest_legal = encs.foldLeft(0.U(3.W)) { (acc, e) =>
+      Mux(acc === 0.U && legal(e - 1), e.U(3.W), acc)
+    }
+    val largest_le_req = encs.reverse.foldLeft(0.U(3.W)) { (acc, e) =>
+      Mux(acc === 0.U && legal(e - 1) && (e.U(3.W) <= request_enc),
+          e.U(3.W), acc)
+    }
+
+    Mux(cand_is_legal, candidate,
+      Mux(is_nonzero_request,
+        Mux(largest_le_req =/= 0.U, largest_le_req, smallest_legal),
+        largest_legal))
+  }
+
   def vl(avl: UInt, currentVL: UInt, useCurrentVL: Bool, useMax: Bool, useZero: Bool): UInt = {
     val atLeastMaxVLMax = useMax || Mux(useCurrentVL, currentVL >= maxVLMax.U, avl >= maxVLMax.U)
     val avl_lsbs = Mux(useCurrentVL, currentVL, avl)(maxVLMax.log2 - 1, 0)
