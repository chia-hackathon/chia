+// The multiply-accumulate cannot be interrupted; nonzero vstart is
+// illegal. vm=1 is required; vm=0 for this funct6 is separately defined
+// as vfqimmacc.vv and would not decode as vqmmacc.vv given our
+// MATCH/MASK. Masking is not supported.
+// require_extension(EXT_ZVVMM);  // reference model does not gate on the extension
+
+// require_vector(true) verifies !vill and enforces vstart == 0 for ALU
+// ops (unless vstart_alu opt-in), and marks the VS field dirty.
+require_vector(true);
+
+// Per SAIL: vm=1 is the vqmmacc form. Our MATCH/MASK already gates on
+// bit 25 = 1, so this is defensive.
+require(insn.v_vm() == 1);
+
+const reg_t sew  = P.VU.vsew;
+const reg_t vlen = P.VU.VLEN;
+// Quad-widening: SEW ∈ {16, 32, 64}.  SEW = 8 would give EEW = 2,
+// which is reserved (per SAIL: "if SEW_check == 8 then return
+// Illegal_Instruction()").
+require(sew == 16 || sew == 32 || sew == 64);
+
+// IME requires an integer LMUL in {1, 2, 4, 8}. Fractional and reserved
+// LMUL raise illegal-instruction (SAIL decode_ime_lmul).
+const float flmul = P.VU.vflmul;
+require(flmul == 1.0f || flmul == 2.0f || flmul == 4.0f || flmul == 8.0f);
+const reg_t lmul = (reg_t)flmul;
+
+// Lambda must be selected (nonzero) and supported for (VLEN, SEW).
+const reg_t lambda = P.VU.ime_lambda;
+require(lambda != 0);
+require(P.VU.ime_lambda_supported(sew, lambda));
+
+// Tile geometry (W = 4).  decode_gemm_geometry with W = 4:
+//   EEW_C  = SEW
+//   EEW_A  = SEW / W = SEW / 4          (in bits)
+//   K_eff  = LAMBDA * W * LMUL          = LAMBDA * 4 * LMUL
+//   M      = LMUL * VLEN / (EEW_A * K_eff)
+//          = LMUL * VLEN / ((SEW/4) * LAMBDA * 4 * LMUL)
+//          = VLEN / (SEW * LAMBDA)
+//   EMUL_C = M / LAMBDA = VLEN / (SEW * LAMBDA^2)
+//   N      = VL / (LAMBDA * LMUL)       (VL must be a multiple of LAMBDA*LMUL)
+//   N_max  = M                          (physical row stride of C)
+const reg_t W      = 4;
+const reg_t eew_a  = sew / W;                     // in bits (4, 8, or 16)
+const reg_t k_eff  = lambda * W * lmul;
+const reg_t m_tile = vlen / (sew * lambda);
+const reg_t emul_c = m_tile / lambda;
+require(emul_c == 1 || emul_c == 2 || emul_c == 4 ||
+        emul_c == 8 || emul_c == 16);
+
+const reg_t vl_div = lambda * lmul;
+const reg_t vl = P.VU.vl->read();
+require(vl % vl_div == 0);
+const reg_t n_tile = vl / vl_div;
+require(n_tile <= m_tile);
+
+// Register-group alignment, bounds, and destination/source overlap.
+// vs1, vs2 form LMUL-register groups; vd forms an EMUL_C-register group.
+const reg_t vd  = insn.rd();
+const reg_t vs1 = insn.rs1();
+const reg_t vs2 = insn.rs2();
+require(vs1 % lmul == 0 && vs1 + lmul <= (reg_t)NVPR);
+require(vs2 % lmul == 0 && vs2 + lmul <= (reg_t)NVPR);
+require(vd  % emul_c == 0 && vd + emul_c <= (reg_t)NVPR);
+auto overlap = [](reg_t a0, reg_t alen, reg_t b0, reg_t blen) {
+  return !(a0 + alen <= b0 || b0 + blen <= a0);
+};
+require(!overlap(vd, emul_c, vs1, lmul));
+require(!overlap(vd, emul_c, vs2, lmul));
+
+// Signedness of A and B is selected by altfmt_A / altfmt_B (0 = signed,
+// 1 = unsigned). C is always signed.
+const bool signed_A = (P.VU.ime_altfmt_A == 0);
+const bool signed_B = (P.VU.ime_altfmt_B == 0);
+
+// Elements per register at EEW_A (for A/B) and EEW_C (= SEW, for C).
+const reg_t epr_a = vlen / eew_a;
+const reg_t epr_c = vlen / sew;
+const reg_t n_max = m_tile;
+
+// Map a 2D tile element index to the flat register-group element index,
+// per SAIL tile_reg_idx(i, group_regs, row_elems_per_reg, elems_per_reg).
+auto tile_reg_idx = [](reg_t i, reg_t group_regs,
+                       reg_t row_elems_per_reg,
+                       reg_t elems_per_reg) -> reg_t {
+  const reg_t linesize     = row_elems_per_reg * group_regs;
+  const reg_t line         = i / linesize;
+  const reg_t elem_in_line = i % linesize;
+  const reg_t regoff       = elem_in_line / row_elems_per_reg;
+  const reg_t elementoff   = line * row_elems_per_reg +
+                             (elem_in_line % row_elems_per_reg);
+  return regoff * elems_per_reg + elementoff;
+};
+
+// row_elems_per_reg for A/B is lambda * W = lambda * 4  (SAIL mat_A_idx /
+// mat_B_idx pass lambda * W to tile_reg_idx).
+const reg_t rer_ab = lambda * W;
+
+// Read a single EEW_A-wide A/B element (as a mathematical integer) from
+// vector-register-file base `base` at flat register-group element index
+// `flat`.  EEW_A ∈ {4, 8, 16}. For EEW_A = 4 (SEW = 16, Zvvi4i16mm), two
+// elements are packed per byte in little-endian order: the low nibble is
+// the even-indexed element, the high nibble the odd-indexed one.
+auto read_ab = [&](reg_t base, reg_t flat, bool is_signed) -> int64_t {
+  switch (eew_a) {
+    case 4: {
+      const reg_t byte_idx = flat >> 1;
+      const uint8_t byte   = P.VU.elt<uint8_t>(base, byte_idx, false);
+      const uint8_t nib    = (flat & 1) ? (uint8_t)(byte >> 4)
+                                        : (uint8_t)(byte & 0xF);
+      if (is_signed) {
+        // Sign-extend from 4 bits: shift to top of a signed byte, then
+        // arithmetic-right-shift back down.
+        return (int64_t)((int8_t)(nib << 4) >> 4);
+      }
+      return (int64_t)(uint64_t)nib;
+    }
+    case 8:
+      if (is_signed)
+        return (int64_t)(int8_t)P.VU.elt<int8_t>(base, flat, false);
+      return (int64_t)(uint64_t)P.VU.elt<uint8_t>(base, flat, false);
+    case 16:
+      if (is_signed)
+        return (int64_t)(int16_t)P.VU.elt<int16_t>(base, flat, false);
+      return (int64_t)(uint64_t)P.VU.elt<uint16_t>(base, flat, false);
+    default:
+      require(false);
+      return 0;
+  }
+};
+
+// int_gemm: for each (j, i), accumulate the block dot product over
+// k = 0..K_eff-1 exactly, then modular-truncate to SEW bits when writing
+// back C. Because modular addition is associative and commutative, any
+// accumulation order is valid.
+for (reg_t j = 0; j < n_tile; ++j) {
+  for (reg_t i = 0; i < m_tile; ++i) {
+    // SAIL mat_C_idx, verbatim:
+    //   function mat_C_idx(i : int, j : int, N_max : int,
+    //                      EMUL_C : int, lambda : int, epr : int) -> int =
+    //     tile_reg_idx(i * N_max + j, EMUL_C, lambda, epr)
+    // The group multiplier is EMUL_C (from the tile geometry), not LMUL.
+    const reg_t c_flat = tile_reg_idx(i * n_max + j, emul_c, lambda, epr_c);
+
+    // acc holds the running sum modulo 2^64. Since the largest possible
+    // K_eff (VLEN=256, lambda=4, LMUL=8, W=4 → K_eff=128) times the
+    // maximum |product| (SEW=64, EEW=16: 2^32) is well below 2^64, and
+    // in general SEW <= 64 means accumulation modulo 2^SEW is preserved
+    // in the low 64 bits of the modulo-2^64 sum.
+    uint64_t acc;
+    switch (sew) {
+      case 16: acc = (uint64_t)(int64_t)(int16_t)P.VU.elt<int16_t>(vd, c_flat, false); break;
+      case 32: acc = (uint64_t)(int64_t)(int32_t)P.VU.elt<int32_t>(vd, c_flat, false); break;
+      case 64: acc = (uint64_t)P.VU.elt<uint64_t>(vd, c_flat, false); break;
+      default: acc = 0; require(false); break;
+    }
+
+    for (reg_t k = 0; k < k_eff; ++k) {
+      // SAIL: a_flat = mat_A_idx(i, k, K_eff, LMUL, lambda, W, epr_A)
+      //             = tile_reg_idx(i * K_eff + k, LMUL, lambda * W, epr_A)
+      //       b_flat = mat_B_idx(k, j, K_eff, LMUL, lambda, W, epr_A)
+      //             = tile_reg_idx(j * K_eff + k, LMUL, lambda * W, epr_A)
+      const reg_t a_flat = tile_reg_idx(i * k_eff + k, lmul, rer_ab, epr_a);
+      const reg_t b_flat = tile_reg_idx(j * k_eff + k, lmul, rer_ab, epr_a);
+
+      const int64_t a = read_ab(vs1, a_flat, signed_A);
+      const int64_t b = read_ab(vs2, b_flat, signed_B);
+
+      // Compute in uint64_t to sidestep signed-overflow UB.  The low SEW
+      // bits of a signed*signed / signed*unsigned / unsigned*unsigned
+      // product on two-value operands whose sign-/zero-extensions are
+      // stored in uint64_t are identical, and that is exactly what
+      // accumulation modulo 2^SEW requires.
+      const uint64_t prod = (uint64_t)a * (uint64_t)b;
+      acc += prod;
+    }
+
+    // Truncate to SEW bits (modular wrap) when writing back C.
+    switch (sew) {
+      case 16: P.VU.elt<int16_t>(vd, c_flat, true) = (int16_t)(uint16_t)acc; break;
+      case 32: P.VU.elt<int32_t>(vd, c_flat, true) = (int32_t)(uint32_t)acc; break;
+      case 64: P.VU.elt<int64_t>(vd, c_flat, true) = (int64_t)acc; break;
+      default: require(false); break;
+    }
+  }
+}
+
+// C tile tail policy: for j in [N, N_max) with 0 <= i < M, the C
+// elements are C-tile tail elements. The SAIL int_gemm never writes
+// them; leaving them undisturbed matches vmmacc.vv's convention and
+// satisfies both vta=0 (undisturbed) and vta=1 (agnostic).
+
+P.VU.vstart->write(0);
