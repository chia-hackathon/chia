+// vqmmacc.vv vd, vs1, vs2  — Zvvmm Integer Quad-Widening Matrix
+// Multiply-Accumulate.
+//
+// C  <-  C + A_tile * B_tile^T
+// with widening factor W = 4 applied to the K dimension.
+// A_tile and B_tile have elements of width SEW/4; C has elements of width SEW.
+//
+// This is a literal transcription of the SAIL semantics in
+// integrated-matrix-v0.9.0.adoc:
+//
+//   if vstart != 0 then return Illegal_Instruction();
+//   let SEW_check : int = 2 ^ get_sew_pow();
+//   if SEW_check == 8 then return Illegal_Instruction();
+//   let g : gemm_geom = decode_gemm_geometry(4);
+//   check_int_encoding_legality(4, g.EEW_C, vtype[altfmt_A], vtype[altfmt_B]);
+//   let signed_A : bool = vtype[altfmt_A] == 0b0;
+//   let signed_B : bool = vtype[altfmt_B] == 0b0;
+//   int_gemm(g, signed_A, signed_B, vs1, vs2, vd);
