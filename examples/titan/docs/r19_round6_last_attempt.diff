+// k = 0..K_eff-1 exactly, then modular-truncate to SEW bits when writing
+// back C. Because modular addition is associative and commutative, any
+// accumulation order is valid.
+for (reg_t j = 0; j < n_tile; ++j) {
+  for (reg_t i = 0; i < m_tile; ++i) {
+    // SAIL mat_C_idx, verbatim:
+    //   function mat_C_idx(i : int, j : int, N_max : int,
+    //                      EMUL_C : int, lambda : int, epr : int) -> int =
+    //     tile_reg_idx(i * N_max + j, EMUL_C, lambda, epr)
+    // The group multiplier is EMUL_C (from the tile geometry), not LMUL.
+    const reg_t c_flat = tile_reg_idx(i * n_max + j, emul_c, lambda, epr_c);
+
+    // acc holds the running sum modulo 2^64. Since the largest possible
+    // K_eff (VLEN=256, lambda=4, LMUL=8, W=2 -> K_eff=64) times the
+    // maximum |product| (SEW=64, EEW=32: 2^64) is well beyond 2^64, but
+    // the reduction is modulo 2^SEW and the low 64 bits of accumulation
+    // in uint64_t match the low 64 bits of the mathematical result at
+    // every step, so truncating to SEW at the end preserves the SAIL
+    // int_gemm semantics.
+    uint64_t acc;
+    switch (sew) {
+      case 8:  acc = (uint64_t)(int64_t)(int8_t )P.VU.elt<int8_t >(vd, c_flat, false); break;
+      case 16: acc = (uint64_t)(int64_t)(int16_t)P.VU.elt<int16_t>(vd, c_flat, false); break;
+      case 32: acc = (uint64_t)(int64_t)(int32_t)P.VU.elt<int32_t>(vd, c_flat, false); break;
+      case 64: acc = (uint64_t)P.VU.elt<uint64_t>(vd, c_flat, false); break;
+      default: acc = 0; require(false); break;
+    }
+
+    for (reg_t k = 0; k < k_eff; ++k) {
+      // SAIL: a_flat = mat_A_idx(i, k, K_eff, LMUL, lambda, W, epr_A)
+      //             = tile_reg_idx(i * K_eff + k, LMUL, lambda * W, epr_A)
+      //       b_flat = mat_B_idx(k, j, K_eff, LMUL, lambda, W, epr_A)
+      //             = tile_reg_idx(j * K_eff + k, LMUL, lambda * W, epr_A)
+      const reg_t a_flat = tile_reg_idx(i * k_eff + k, lmul, rer_ab, epr_a);
+      const reg_t b_flat = tile_reg_idx(j * k_eff + k, lmul, rer_ab, epr_a);
+
+      const int64_t a = read_ab(vs1, a_flat, signed_A);
+      const int64_t b = read_ab(vs2, b_flat, signed_B);
+
+      // Compute in uint64_t to sidestep signed-overflow UB.  The low SEW
+      // bits of a signed*signed / signed*unsigned / unsigned*unsigned
+      // product on two-value operands whose sign-/zero-extensions are
+      // stored in uint64_t are identical, and that is exactly what
+      // accumulation modulo 2^SEW requires.
+      const uint64_t prod = (uint64_t)a * (uint64_t)b;
+      acc += prod;
+    }
+
+    // Truncate to SEW bits (modular wrap) when writing back C.
+    switch (sew) {
+      case 8:  P.VU.elt<int8_t >(vd, c_flat, true) = (int8_t )(uint8_t )acc; break;
+      case 16: P.VU.elt<int16_t>(vd, c_flat, true) = (int16_t)(uint16_t)acc; break;
+      case 32: P.VU.elt<int32_t>(vd, c_flat, true) = (int32_t)(uint32_t)acc; break;
+      case 64: P.VU.elt<int64_t>(vd, c_flat, true) = (int64_t)acc; break;
+      default: require(false); break;
+    }
+  }
+}
+
+// C tile tail policy: for j in [N, N_max) with 0 <= i < M, the C
+// elements are C-tile tail elements. The SAIL int_gemm never writes
+// them; leaving them undisturbed matches vmmacc.vv's convention and
+// satisfies both vta=0 (undisturbed) and vta=1 (agnostic).
+
