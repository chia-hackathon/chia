@@ -0,0 +1,103 @@
+// Zvvm Integer Matrix Multiply-Accumulate (vmmacc.vv).
+package saturn.exu
+
+import chisel3._
+import chisel3.util._
+import org.chipsalliance.cde.config._
+import freechips.rocketchip.rocket._
+import freechips.rocketchip.util._
+import freechips.rocketchip.tile._
+import saturn.common._
+import saturn.insns._
+
+case class MatrixMultiplyFactory() extends FunctionalUnitFactory {
+  def insns = Seq(VMMACC_VV.elementWise.iterative)
+  def generate(implicit p: Parameters) = new MatrixMultiplyPipe()(p)
+}
+
+class MatrixMultiplyPipe(implicit p: Parameters) extends IterativeFunctionalUnit()(p) {
+  io.set_vxsat := false.B
+  io.set_fflags.valid := false.B
+  io.set_fflags.bits := DontCare
+  io.scalar_write.valid := false.B
+  io.scalar_write.bits := DontCare
+  io.acc := false.B
+
+  val sew = op.vd_eew
+
+  val a_elem_idx = op.matrix_a_pos >> sew
+  val b_elem_idx = op.matrix_b_pos >> sew
+  val c_elem_idx = op.matrix_c_pos >> sew
+
+  val a_raw = extractElem(op.rvs1_data, sew, a_elem_idx)(63, 0)
+  val b_raw = extractElem(op.rvs2_data, sew, b_elem_idx)(63, 0)
+  val c_raw = extractElem(op.rvd_data,  sew, c_elem_idx)(63, 0)
+
+  def signExtend(elem: UInt, sewSel: UInt, signed: Bool): SInt = {
+    VecInit.tabulate(4)({ eew =>
+      val w = 8 << eew
+      if (w >= 64) elem(63, 0)
+      else Cat(Fill(64 - w, signed && elem(w - 1)), elem(w - 1, 0))
+    })(sewSel).asSInt
+  }
+
+  val a_ext = signExtend(a_raw, sew, !op.matrix_altfmt_A)
+  val b_ext = signExtend(b_raw, sew, !op.matrix_altfmt_B)
+  val c_ext = signExtend(c_raw, sew, true.B).asUInt
+
+  val product = (a_ext * b_ext).asUInt
+
+  // Explicit two-Reg design: capture c_ext at first_k, then accumulate
+  // products separately. At last_k, WRITE = c_captured + prev_product_sum +
+  // current_product. This eliminates the force_first Mux path where a Reg
+  // update race could contaminate matrix_acc with residual state from the
+  // previous cell.
+  val c_ext_captured = Reg(UInt(64.W))
+  val product_sum    = RegInit(0.U(64.W))
+  val valid_prev     = RegNext(valid, false.B)
+
+  when (valid && !valid_prev) {
+    when (op.matrix_first_k) {
+      c_ext_captured := c_ext
+      product_sum    := product(63, 0)
+    } .elsewhen (!op.matrix_last_k) {
+      // Skip accumulating at last_k. new_acc already includes current
+      // product via the direct add; updating product_sum here creates a
+      // race if write.ready is ever low at last_k (valid stays high a
+      // second cycle, and new_acc would then double-add the current
+      // product).
+      product_sum    := (product_sum +& product(63, 0))(63, 0)
+    }
+  }
+
+  // At the last_k write cycle, the current iter's product hasn't been folded
+  // into product_sum yet (Reg update happens at posedge). So compute:
+  //   result = c_captured + product_sum + product(current)
+  // For a K=1 cell (first_k == last_k), c_captured / product_sum still hold
+  // the PREVIOUS cell's values at the write moment. Handle by using c_ext /
+  // 0 in that case.
+  val use_first    = op.matrix_first_k
+  val write_c      = Mux(use_first, c_ext,   c_ext_captured)
+  val write_prev_s = Mux(use_first, 0.U(64.W), product_sum)
+  val new_acc      = (write_c +& write_prev_s +& product(63, 0))(63, 0)
+
+  val result_sew = VecInit.tabulate(4)({ eew =>
+    new_acc((8 << eew) - 1, 0)
+  })(sew)
+  val result_replicated = dLenSplat(result_sew, sew)
+
+  io.write.valid     := valid && op.matrix_last_k
+  io.write.bits.eg   := op.wvd_eg
+  io.write.bits.data := result_replicated
+  io.write.bits.mask := FillInterleaved(8, op.wmask)
+
+  io.hazard.valid    := valid
+  io.hazard.bits.eg  := op.wvd_eg
+  io.hazard.bits.vat := op.vat
+
+  io.tail := op.tail
+
+  last := Mux(op.matrix_last_k, io.write.fire, valid)
+
+  io.stall := valid
+}
