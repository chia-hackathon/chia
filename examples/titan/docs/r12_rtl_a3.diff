+  if (masked && !P.VU.mask_elt(0, i)) {
+    // Inactive element: no memory write, no exception.
+    continue;
+  }
+  P.VU.vstart->write(i);
+
+  // The SAIL appendix is normative and states, verbatim:
+  //     let flat_idx : int =
+  //       tile_reg_idx(i, LMUL, eff_lambda, elems_per_reg);
+  //     let mem_off : int =
+  //       (i / linesize) * LD + (i % linesize);
+  // i is the *sequential* tile element index. Memory is addressed with i
+  // directly -- so an A/B tile is a plain row-major M x K_eff panel with
+  // stride LD at every LMUL -- and only the register side goes through
+  // tile_reg_idx. The two are never composed. At LMUL = 1 tile_reg_idx is
+  // the identity, which is why the prose reading and the SAIL agree there.
+  const reg_t flat_idx = tile_reg_idx(i, lmul, eff_lambda, elems_per_reg);
+  const reg_t mem_off  = (i / linesize) * ld + (i % linesize);
+  const reg_t addr     = base_addr + mem_off * eew_bytes;
+
+  switch (sew) {
+    case 8:  MMU.store<uint8_t >(addr, P.VU.elt<uint8_t >(vs3, flat_idx, false)); break;
+    case 16: MMU.store<uint16_t>(addr, P.VU.elt<uint16_t>(vs3, flat_idx, false)); break;
+    case 32: MMU.store<uint32_t>(addr, P.VU.elt<uint32_t>(vs3, flat_idx, false)); break;
+    case 64: MMU.store<uint64_t>(addr, P.VU.elt<uint64_t>(vs3, flat_idx, false)); break;
+    default: require(false); break;
+  }
+}
