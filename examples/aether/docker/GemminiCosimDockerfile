# chia-chisel-build-cosimfix + spike custom-extension support in cospike
#                            + a Rocket+Gemmini cosim config
#
# Both patched files are plain source in the chipyard tree (a testchipip resource
# .cc that is copied into gen-collateral at elaboration time, and a Scala config),
# so no toolchain rebuild is needed -- this layer is a few seconds.
#
# Base MUST be the cosimfix image: it carries the debug_rob.cc Bug 1 fix, without
# which cospike traps nondeterministically and any Gemmini result is meaningless.
FROM chia-chisel-build-cosimfix:local

USER root
ARG CP=/home/ray/chipyard/generators/testchipip/src/main/resources/testchipip/csrc/cospike_impl.cc
ARG GC=/home/ray/chipyard/generators/gemmini/chipyard/GemminiConfigs.scala

COPY fix_cospike_extension.py /tmp/fix_cospike_extension.py
COPY add_gemmini_cosim_config.py /tmp/add_gemmini_cosim_config.py
RUN cp ${CP} ${CP}.orig && python3 /tmp/fix_cospike_extension.py ${CP} \
 && cp ${GC} ${GC}.orig && python3 /tmp/add_gemmini_cosim_config.py ${GC} \
 && rm /tmp/fix_cospike_extension.py /tmp/add_gemmini_cosim_config.py

# --- verification: fail the build loudly if either patch did not land ---
RUN grep -q '#include <riscv/extension.h>' ${CP} \
 && grep -q '+cospike-extension=' ${CP} \
 && grep -q '+cospike-extlib=' ${CP} \
 && grep -q 'COSPIKE_EXTENSIONS' ${CP} \
 && grep -q 'info->isa += tok;' ${CP} \
 && test "$(grep -c 'cospike_split_list' ${CP})" = "5" \
 && echo "cospike_impl.cc extension patch verified"

RUN grep -q 'class GemminiRocketCosimConfig extends Config(' ${GC} \
 && grep -q 'chipyard.harness.WithCospike' ${GC} \
 && grep -q 'gemmini.DefaultGemminiConfig' ${GC} \
 && test "$(grep -c 'class GemminiShuttleConfig' ${GC})" = "1" \
 && echo "GemminiConfigs.scala cosim config verified"

# the base image's Bug 1 fix must still be present
RUN grep -q 'memset(trace_wdata, 0, WDATA_BYTES);' \
      /home/ray/chipyard/generators/rocket-chip/src/main/resources/csrc/debug_rob.cc \
 && echo "base image Bug1 fix still present"

# cospike_impl.cc must still compile against the installed spike headers
RUN g++ -fsyntax-only -std=c++17 -x c++ \
      -I/home/ray/chipyard/.conda-env/riscv-tools/include \
      -I/home/ray/chipyard/generators/testchipip/src/main/resources/testchipip/csrc \
      ${CP} && echo "cospike_impl.cc compiles"

# libgemmini.so must be resolvable by find_extension()'s dlopen("libgemmini.so"):
# libriscv.so's RPATH points at $RISCV/lib, which is where it lives.
RUN test -f /home/ray/chipyard/.conda-env/riscv-tools/lib/libgemmini.so \
 && objdump -x /home/ray/chipyard/.conda-env/riscv-tools/lib/libriscv.so \
      | grep -q 'RPATH .*riscv-tools/lib' \
 && echo "libgemmini.so present and on libriscv RPATH"

RUN chown ray:users ${CP} ${CP}.orig ${GC} ${GC}.orig
USER ray
