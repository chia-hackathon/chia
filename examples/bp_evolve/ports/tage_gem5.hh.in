#ifndef __CPU_PRED_EVOLVED_BP_HH__
#define __CPU_PRED_EVOLVED_BP_HH__

// gem5 adapter for the Tier-0 predictor.  Generated by agents.offline_port();
// the algorithm is ports/tage_core.h.in, shared verbatim with the ChampSim
// port, so a Tier-1/Tier-2 disagreement is about the two cost models and not
// about two people having written TAGE twice.
//
// gem5 differs from ChampSim in one way that matters: it predicts
// speculatively at fetch and can squash. So the adapter snapshots the folded
// history with every in-flight branch and restores it on a squash.  Without
// that, a mispredict leaves the history permanently polluted, which looks like
// a bad predictor rather than a bad adapter -- and would land squarely on the
// number Tier 2 exists to report.  Tables are only written at commit, where
// the outcome is final.

#include "cpu/pred/conditional.hh"
#include "params/EvolvedBP.hh"

${TAGE_CORE}

namespace gem5
{
namespace branch_prediction
{

// ConditionalPredictor, not BPredUnit: in this gem5 the direction predictor is
// a separate SimObject that BPredUnit owns alongside the BTB, the RAS and the
// indirect predictor.  Deriving from BPredUnit compiles far enough to be
// confusing -- the methods simply do not override anything -- and would leave
// the core using its default predictor.
class EvolvedBP : public ConditionalPredictor
{
  public:
    EvolvedBP(const EvolvedBPParams &params);

    bool lookup(ThreadID tid, Addr pc, void *&bp_history) override;
    void updateHistories(ThreadID tid, Addr pc, bool uncond, bool taken,
                         Addr target, const StaticInstPtr &inst,
                         void *&bp_history) override;
    void squash(ThreadID tid, void *&bp_history) override;
    void update(ThreadID tid, Addr pc, bool taken, void *&bp_history,
                bool squashed, const StaticInstPtr &inst, Addr target) override;

  private:
    struct BPHistory
    {
        tage_core::history hist;     // to restore on a squash
        tage_core::lookup lk;        // what the lookup saw
        bool uncond = false;
        bool pred = false;
    };

    tage_core core;
};

} // namespace branch_prediction
} // namespace gem5

#endif // __CPU_PRED_EVOLVED_BP_HH__
