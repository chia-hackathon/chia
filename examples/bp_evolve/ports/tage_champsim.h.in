#ifndef BRANCH_EVOLVED_BP_H
#define BRANCH_EVOLVED_BP_H

// ChampSim adapter for the Tier-0 predictor.  Generated by
// agents.offline_port(); the algorithm below the adapter is
// ports/tage_core.h.in, shared verbatim with the gem5 port.
//
// ChampSim asks once per branch, in order, with no speculation visible to the
// module -- so the adapter is nearly nothing: predict on the way in, update on
// the way out, advance the history on every branch.  The P1 (gshare) level of
// the HARCOM design is not ported: it is overridden by P2 on every
// instruction, so it contributes to Tier 0's latency and energy accounting and
// to no prediction ChampSim could observe.

#include "address.h"
#include "instruction.h"
#include "modules.h"

${TAGE_CORE}

struct evolved_bp : champsim::modules::branch_predictor {
  tage_core core;
  tage_core::lookup last;

  explicit evolved_bp(O3_CPU* cpu) : champsim::modules::branch_predictor(cpu) {}

  bool predict_branch(champsim::address ip)
  {
    last = core.predict(ip.to<uint64_t>());
    return last.final_pred;
  }

  void last_branch_result(champsim::address ip, champsim::address branch_target,
                          bool taken, uint8_t branch_type)
  {
    const uint64_t pc = ip.to<uint64_t>();
    // Only conditional branches train the tables -- the HARCOM predictor is
    // only ever asked about those.  Every branch advances the history, because
    // the original advances it once per prediction block and a block ends at
    // any branch, conditional or not.
    if (branch_type == BRANCH_CONDITIONAL) core.update(last, taken);
    core.advance(taken ? branch_target.to<uint64_t>() : (pc + 4));
  }
};

#endif
